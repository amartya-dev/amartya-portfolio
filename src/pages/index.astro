---
// Index-first.
//
// The old home page was six interactive demos stacked in identical frames, in
// alternating black and white bands, with the actual list of work buried at
// position four. It asked for about nine minutes before it told you what the
// person had built.
//
// This is a contents page. Title, the spans, the index, the writing, an address.
// Every demo still exists — each one is now on the page of the thing it is
// evidence for, which is where somebody who cares about that thing will find it,
// and where it is not competing with three other demos for the same attention.
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import Masthead from '../components/Masthead.astro';
import Spans from '../components/Spans.astro';
import Index from '../components/Index.astro';
import { WORK } from '../data/work.js';
const demos = WORK.filter((w) => w.demo).length;
import Figure from '../components/Figure.astro';
import { PREVIEW } from '../data/previews.js';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d) => d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
const WORDS = ['no', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight'];
---
<Base>
  <Masthead />

  <Band no="I" label="The record" id="record" title="Six years, five spans">
    <Fragment slot="lede">Two companies, a consultancy and two products — and for most of those six
      years, more than one of them was running at once.</Fragment>
    <Fragment slot="note">Solid bars were the main thing at the time. Hollow ones ran alongside it.</Fragment>
    <Spans />
  </Band>

  <Band no="II" label="Index" id="index" title={`${WORK.length} things, and what became of each`}>
    <Fragment slot="lede">From a thousand support conversations an hour down to twenty-nine lines in
      somebody else&rsquo;s repository. Every entry says what state it is actually in &mdash; in production,
      a prototype, or a notebook &mdash; because the reader who bothers to check is the one worth keeping.</Fragment>
    <Fragment slot="note">{WORDS[demos]} entries have something you can operate on their page.
      Those are marked <em>demo</em>.</Fragment>
    <Index />
  </Band>

  <Band no="III" label="Writing" id="writing" title="Working notes">
    <Fragment slot="lede">Longer pieces on the things in the index: how they were built, what they
      cost, and the seven experiments that came back negative.</Fragment>
    <Fragment slot="note">Each figure is drawn from that post&rsquo;s own numbers, so no two are
      alike.</Fragment>

    <ol class="posts rv">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}/`}>
            <span class="pbody">
              <span class="pdate mono">{fmt(p.data.date)}</span>
              <span class="ptitle d">{p.data.title}</span>
              <span class="pblurb">{p.data.description}</span>
            </span>
            <Figure f={PREVIEW[p.id]} />
          </a>
        </li>
      ))}
    </ol>
    <a class="more" href="/blog">All of it <span aria-hidden="true">→</span></a>
  </Band>

  <section id="contact" class="chamber sec close">
    <div class="wrap">
      <div class="flowline" aria-hidden="true"></div>
      <div class="spread">
      <div class="rail" aria-hidden="true"><span class="railhead"><span class="no">IV</span><span class="lbl">Address</span></span></div>
      <div class="col">
        <h2 class="d d-sec">What&rsquo;s breaking?</h2>
        <p class="lede">Agents, evals, or the platform underneath. Any of those three, and I will have
          seen the failure mode before.</p>
        <a class="bigmail d" href="mailto:amartya@hunr.ai">amartya@hunr.ai</a>
        <ul class="addr">
          <li><a href="https://hunr.ai" rel="noopener">hunr.ai</a></li>
          <li><a href="https://github.com/amartya-dev" rel="me noopener">GitHub</a></li>
          <li><a href="https://linkedin.com/in/amartya-gaur" rel="me noopener">LinkedIn</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Three posts, set as a contents list with each post's own figure beside it.
     The figures are drawn from each post's real numbers, so no two are alike —
     which is what keeps this from being a grid of identical cards. */
  .posts { border-top: 1px solid var(--ink); }
  .posts li { border-bottom: 1px solid var(--rule); }
  .posts a {
    display: grid; grid-template-columns: minmax(0, 1fr) 200px; gap: 44px;
    align-items: center; padding: 26px 0; text-decoration: none;
  }
  .pbody { display: grid; gap: 8px; max-width: 56ch; }
  .pdate { color: var(--mid); letter-spacing: .06em; text-transform: uppercase; font-size: var(--t-micro); }
  .ptitle {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem); font-weight: 400;
    letter-spacing: -.016em; line-height: 1.15; transition: color .16s ease;
  }
  .posts a:hover .ptitle { color: var(--fail-ink); }
  .pblurb { color: var(--ink-2); font-size: var(--t-small); line-height: 1.65; }

  .more {
    display: inline-block; margin-top: var(--s-3); font-size: var(--t-small); font-weight: 500;
    color: var(--mid); text-decoration: none; border-bottom: 1px solid var(--rule);
    padding-bottom: 4px;
  }
  .more:hover { color: var(--fail-ink); border-color: var(--fail-ink); }
  .more span { display: inline-block; transition: transform .22s ease; }
  .more:hover span { transform: translateX(4px); }

  /* The document closes in ink, the way it opened. */
  .close .lede { color: var(--bone-2); }
  .close h2 { color: var(--bone); }
  .bigmail {
    display: inline-block; margin-top: clamp(34px, 4.6vw, 56px);
    font-size: clamp(1.6rem, 5.4vw, 3.6rem); font-weight: 380; letter-spacing: -.024em;
    color: var(--bone); text-decoration: none; word-break: break-word;
    border-bottom: 1px solid var(--rule-dark-2); padding-bottom: 6px;
  }
  .bigmail:hover { color: var(--fail-lit); border-color: var(--fail-lit); }
  .addr {
    display: flex; flex-wrap: wrap; gap: 10px 28px;
    margin-top: clamp(34px, 4vw, 48px); font-size: var(--t-small); color: var(--bone-dim);
  }
  .addr a { color: var(--bone-2); }

  @media (max-width: 860px) {
    .posts a { grid-template-columns: 1fr; gap: 18px; }
    .posts a :global(.fig) { max-width: 220px; }
  }
</style>
