---
// A front page, not the whole book.
//
// The version before this one was a contents page that reproduced its own
// contents: all twenty-four index entries, each with a hook, a client, a year
// and a status word, which came to nine and a half screens and a thousand
// words. A designer read it and said he did not feel like exploring, which is
// the correct response to being handed everything at once — there is nothing
// left to go and find.
//
// So this page now argues one thing and offers three doors. The claim is drawn
// rather than written, six things stand as evidence for it, three posts stand
// behind those, and the full record — every entry, every status, the five
// overlapping spans — moved to /work for the reader who wants it.
//
// It opened for a while on the hunr product film, as a frontispiece. That came
// out again: the same footage was already the thumbnail on the product-motion
// entry and again on the post about how it was cut, so the page ran one piece of
// video three times before a reader reached the contact band. It is on the hunr
// page and in that post, which is twice, which is enough.
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import Masthead from '../components/Masthead.astro';
import Layer from '../components/Layer.astro';
import Selected from '../components/Selected.astro';
import Figure from '../components/Figure.astro';
import { WORK } from '../data/work.js';
import { PREVIEW } from '../data/previews.js';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d) => d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
---
<Base>
  <Masthead />

  <Band no="I" label="The layer" id="layer" title="Underneath the agent">
    <Fragment slot="lede">Three layers, and the piece of work that stands as evidence for
      each.</Fragment>
    <Fragment slot="note">The top tier is dashed because it is not mine. It is the part you are
      building.</Fragment>
    <Layer />
  </Band>

  <Band no="II" label="Work" id="index" title="Six things I have built">
    <Fragment slot="lede">Picked from twenty-four because they ran somewhere real, for long enough
      to teach me something. The rest of them &mdash; including the ones that did not work &mdash; are
      in the full index.</Fragment>
    <Selected />
  </Band>

  <Band no="III" label="Writing" id="writing" title="Working notes">
    <Fragment slot="lede">How a few of these were built, what they cost, and the parts that were
      not in anybody&rsquo;s documentation.</Fragment>

    <ol class="posts rv">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}/`}>
            <span class="pbody">
              <span class="pdate mono">{fmt(p.data.date)}</span>
              <span class="ptitle d">{p.data.title}</span>
              <span class="pblurb">{p.data.description}</span>
            </span>
            <Figure f={PREVIEW[p.id]} />
          </a>
        </li>
      ))}
    </ol>
    <a class="more" href="/blog">All of it <span aria-hidden="true">→</span></a>
  </Band>

  <section id="contact" class="chamber sec close">
    <div class="wrap">
      <div class="flowline" aria-hidden="true"></div>
      <div class="spread">
      <div class="rail" aria-hidden="true"><span class="railhead"><span class="no">IV</span><span class="lbl">Address</span></span></div>
      <div class="col">
        <h2 class="d d-sec">If any of this is useful</h2>
        <p class="lede">Agents, evals, or the infrastructure underneath &mdash; I am glad to talk about
          any of it, and you do not need a reason.</p>
        <a class="bigmail d" href="mailto:amartya@hunr.ai">amartya@hunr.ai</a>

        <!-- His own calendar rather than hunr's. The link used to point at the
             hunr.ai product demo, which was the only slot that existed, and a
             visitor here is asking about the engineer rather than the product. -->
        <a class="book" href="https://cal.com/amartyagaur/intro" rel="noopener">
          <span class="book-t">Find a time to talk</span>
          <span class="book-m">Cal.com &middot; fifteen minutes, no agenda</span>
          <span class="book-a" aria-hidden="true">&rarr;</span>
        </a>

        <ul class="addr">
          <li><a href="/work">All {WORK.length} things</a></li>
          <li><a href="https://hunr.ai" rel="noopener">hunr.ai</a></li>
          <li><a href="https://github.com/amartya-dev" rel="me noopener">GitHub</a></li>
          <li><a href="https://linkedin.com/in/amartya-gaur" rel="me noopener">LinkedIn</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Three posts, set as a contents list with each post's own figure beside it.
     The figures are drawn from each post's real numbers, so no two are alike —
     which is what keeps this from being a grid of identical cards. */
  .posts { border-top: 1px solid var(--ink); }
  .posts li { border-bottom: 1px solid var(--rule); }
  .posts a {
    display: grid; grid-template-columns: minmax(0, 1fr) 200px; gap: 44px;
    align-items: center; padding: 26px 0; text-decoration: none;
  }
  .pbody { display: grid; gap: 8px; max-width: 56ch; }
  .pdate { color: var(--mid); letter-spacing: .06em; text-transform: uppercase; font-size: var(--t-micro); }
  .ptitle {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem); font-weight: 400;
    letter-spacing: -.016em; line-height: 1.15; transition: color .16s ease;
  }
  .posts a:hover .ptitle { color: var(--fail-ink); }
  .pblurb { color: var(--ink-2); font-size: var(--t-small); line-height: 1.65; }

  .more {
    display: inline-block; margin-top: var(--s-3); font-size: var(--t-small); font-weight: 500;
    color: var(--mid); text-decoration: none; border-bottom: 1px solid var(--rule);
    padding-bottom: 4px;
  }
  .more:hover { color: var(--fail-ink); border-color: var(--fail-ink); }
  .more span { display: inline-block; transition: transform .22s ease; }
  .more:hover span { transform: translateX(4px); }

  /* The document closes in ink, the way it opened. */
  .close .lede { color: var(--bone-2); }
  .close h2 { color: var(--bone); }
  .bigmail {
    display: inline-block; margin-top: clamp(34px, 4.6vw, 56px);
    font-size: clamp(1.6rem, 5.4vw, 3.6rem); font-weight: 380; letter-spacing: -.024em;
    color: var(--bone); text-decoration: none; word-break: break-word;
    border-bottom: 1px solid var(--rule-dark-2); padding-bottom: 6px;
  }
  .bigmail:hover { color: var(--fail-lit); border-color: var(--fail-lit); }
  /* A plate rather than a button: a hairline frame, the label, and what it
     actually is underneath it. The same device the figures use, at the size of a
     thing you press. */
  .book {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center;
    gap: 4px 20px; max-width: 30rem;
    margin-top: clamp(30px, 3.6vw, 42px); padding: 16px 20px;
    border: 1px solid var(--rule-dark-2); border-radius: var(--r);
    text-decoration: none; background: var(--void-2);
    transition: border-color .18s ease, background-color .18s ease;
  }
  .book:hover { border-color: var(--bone-3); background: var(--void-3); color: inherit; }
  /* Explicit placement for all three. The arrow had no column of its own, so it
     auto-placed into the first one and pushed the label across. */
  .book-t {
    grid-column: 1; grid-row: 1;
    font-size: 1.0625rem; font-weight: 550; color: var(--bone); letter-spacing: -.012em;
  }
  .book-m {
    grid-column: 1; grid-row: 2;
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: .04em; color: var(--bone-3);
  }
  .book-a {
    grid-column: 2; grid-row: 1 / span 2; justify-self: end;
    color: var(--bone-3); font-size: 1.1rem; transition: transform .2s ease, color .18s ease;
  }
  .book:hover .book-a { transform: translateX(4px); color: var(--fail-lit); }

  .addr {
    display: flex; flex-wrap: wrap; gap: 10px 28px;
    margin-top: clamp(30px, 3.6vw, 44px); font-size: var(--t-small); color: var(--bone-dim);
  }
  .addr a { color: var(--bone-2); }

  @media (max-width: 860px) {
    .posts a { grid-template-columns: 1fr; gap: 18px; }
    .posts a :global(.fig) { max-width: 220px; }
  }
</style>
