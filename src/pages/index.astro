---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Gate from '../components/Gate.astro';
import Graph3D from '../components/Graph3D.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---
<Base>
  <Hero />

  <section id="hunr" class="light sec">
    <div class="wrap">
      <p class="mono eyebrow rv">01 — the company</p>
      <h2 class="d d-2 rv">Résumés<br />don&rsquo;t ship</h2>
      <p class="lede rv">The first screen in engineering hiring rewards the wrong things: keywords, take-homes that
        measure free time, and puzzles nobody will write again. hunr replaces it with the work.</p>

      <ol class="loop">
        <li class="rv"><p class="mono step">01 — challenge</p><p>Built from a real codebase or job description: a real
          repository, a hidden test suite, a weighted rubric.</p></li>
        <li class="rv"><p class="mono step">02 — build, agents allowed</p><p>The candidate works in their own repo with
          whatever agent they like. Every push runs against the hidden suite in an isolated sandbox, verdicts live.</p></li>
        <li class="rv"><p class="mono step">03 — defend, unaided</p><p>A timed reasoning round, one question at a time.
          An ownership multiplier decides how much the build actually counts for.</p></li>
        <li class="rv"><p class="mono step">04 — score</p><p>A per-competency fit score with the code cited, reported in
          bands — a 73 and a 71 are the same performance with noise on top.</p></li>
      </ol>

      <div class="hunr-foot rv">
        <dl class="stats mono">
          <div><dt>Applicants screened</dt><dd>175</dd></div>
          <div><dt>Design partners</dt><dd>2</dd></div>
          <div><dt>Built by</dt><dd>One engineer</dd></div>
        </dl>
        <a class="cta" href="https://hunr.ai" rel="noopener">See it at hunr.ai<span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <Gate />

  <section id="record" class="light sec">
    <div class="wrap">
      <p class="mono eyebrow rv">03 — the record</p>
      <h2 class="d d-2 rv">Five years,<br />three spans</h2>
      <p class="lede rv">Two of them ran concurrently. Open one to see what was inside it.</p>

      <div class="panel rv">
        <div class="axis mono" aria-hidden="true">
          <span style="--t:0">2021</span><span style="--t:.1667">2022</span><span style="--t:.3333">2023</span
          ><span style="--t:.5">2024</span><span style="--t:.6667">2025</span><span style="--t:.8333">2026</span>
        </div>
        <ol class="spans">
          <li class="span" style="--s:.0417;--e:.938">
            <button class="span-row" type="button" aria-expanded="true" aria-controls="s1">
              <span class="sl"><b>Newfold Digital</b><i>Senior Software Developer, AI Center of Excellence</i></span>
              <span class="plot"><span class="bar"></span></span>
              <span class="mono dur">5y 5mo</span>
            </button>
            <div class="detail" id="s1">
              <p>Remote, April 2021 to August 2026. I owned the agent orchestration framework behind the production
                support agents for Network Solutions and BigRock, the promptfoo eval harness that gated their releases —
                739 regression cases, about 2,700 assertions, wired in as a blocking Jenkins gate — and the generation
                stack behind the AI-native website builder. Before the AI work: roughly 100,000 Microsoft 365 accounts
                migrated to NCE, and async systems rebuilt to fit low-memory hosting.</p>
            </div>
          </li>
          <li class="span side" style="--s:.1667;--e:.6667">
            <button class="span-row" type="button" aria-expanded="false" aria-controls="s2">
              <span class="sl"><b>PayCrunch</b><i>Founding consultant &amp; technical architect, part-time</i></span>
              <span class="plot"><span class="bar"></span></span>
              <span class="mono dur">2022 – 2025</span>
            </button>
            <div class="detail" id="s2" hidden>
              <p>Architected the backend from zero for a UPI credit lending product at a Y Combinator-backed fintech —
                lending and payment rail integrations with underwriting logic on top — and built the Flutter client
                alongside it. Hired and led the company&rsquo;s first three engineers.</p>
            </div>
          </li>
          <li class="span live" style="--s:.8333;--e:.938">
            <button class="span-row" type="button" aria-expanded="false" aria-controls="s3">
              <span class="sl"><b>hunr.ai</b><i>Founder &amp; engineer, Kodaksh Private Limited</i></span>
              <span class="plot"><span class="bar"></span></span>
              <span class="mono dur">2026 —</span>
            </button>
            <div class="detail" id="s3" hidden>
              <p>Built solo on FastAPI and LangGraph with RabbitMQ, Redis Streams SSE, Postgres, sandboxed code
                execution, Pulumi on Azure, ArgoCD GitOps, and self-hosted observability across three data-residency
                regions. Started on the side; full-time since August 2026.</p>
            </div>
          </li>
        </ol>
        <p class="legend mono">Solid bars are full-time. The hollow one ran alongside.</p>
      </div>

      <ul class="works">
        <li class="rv"><p class="mono w-org">Newfold Digital</p><h3 class="d d-3">Evals that fail a build</h3>
          <p>739 regression cases, about 2,700 assertions, roughly 250 scoring metrics across routing, tool-call
            correctness, and handoff quality — a blocking Jenkins gate, not a dashboard nobody reads.</p></li>
        <li class="rv"><p class="mono w-org">Newfold Digital</p><h3 class="d d-3">AI-native website builder</h3>
          <p>Prompt to live hosted site: a LangGraph generation harness, sandbox orchestration, atomic publishes across
            OCI and Cloudflare. Top contributor, 149 of 334 commits. Time to preview down 48%, 11m54s to 6m12s.</p></li>
        <li class="rv"><p class="mono w-org">Newfold Digital</p><h3 class="d d-3">Public MCP server for deploys</h3>
          <p>Ships to managed VPS straight from Claude Code and Codex — the infrastructure, the DevOps, the tool
            interface, and Cloudflare Enterprise endpoint authorisation.</p></li>
        <li class="rv"><p class="mono w-org">PayCrunch</p><h3 class="d d-3">UPI credit lending backend</h3>
          <p>Built from zero for a YC-backed fintech: lending and payment rail integrations with underwriting on top,
            plus the Flutter client. Hired and led the first three engineers.</p></li>
      </ul>
    </div>
  </section>

  <Graph3D />

  <section id="public" class="light sec">
    <div class="wrap">
      <p class="mono eyebrow rv">05 — in public</p>
      <h2 class="d d-2 rv">109 merged<br />pull requests</h2>
      <p class="lede rv">Outside my own repositories. The four worth naming:</p>

      <ul class="contribs">
        <li class="rv">
          <p class="mono repo"><a href="https://github.com/calesthio/OpenMontage" rel="noopener">calesthio/OpenMontage</a><span>49k stars</span></p>
          <p>Azure AI Speech added as an optional cloud provider twice over —
            <a href="https://github.com/calesthio/OpenMontage/pull/354" rel="noopener">speech-to-text</a> and
            <a href="https://github.com/calesthio/OpenMontage/pull/371" rel="noopener">text-to-speech</a>, both merged,
            about 900 lines each. A <a href="https://github.com/calesthio/OpenMontage/pull/372" rel="noopener">repo-grounded
            product-motion pipeline</a> is open at 4,316 lines across 39 files.</p>
        </li>
        <li class="rv">
          <p class="mono repo"><a href="https://github.com/Textualize/rich" rel="noopener">Textualize/rich</a><span>57k stars</span></p>
          <p>A <a href="https://github.com/Textualize/rich/pull/380" rel="noopener">flag for binary or decimal suffixes</a>
            in <code>DownloadColumn</code>. Merged in 2020.</p>
        </li>
        <li class="rv">
          <p class="mono repo"><a href="https://github.com/newfold-labs" rel="noopener">newfold-labs</a> · <a href="https://github.com/bluehost" rel="noopener">bluehost</a><span>2022 – 2025</span></p>
          <p>Roughly 60 merged pull requests across the WordPress AI module, the help centre&rsquo;s migration from
            Algolia to Typesense, and AI-assisted onboarding.</p>
        </li>
        <li class="rv">
          <p class="mono repo"><a href="https://github.com/cc-archive/cccatalog" rel="noopener">Creative Commons cccatalog</a><span>now Openverse</span></p>
          <p>Automated <a href="https://github.com/cc-archive/cccatalog/pull/344" rel="noopener">test-on-pull-request CI</a>
            and <a href="https://github.com/cc-archive/cccatalog/pull/380" rel="noopener">tag blacklisting in ImageStore</a>.
            Merged in 2020.</p>
        </li>
      </ul>

      <div class="talks rv">
        <h3 class="mono sub">Talks</h3>
        <ul class="plain">
          <li><b>Mastering Gutenberg blocks: from basics to building your own</b> — given three times: WordCamp
            <a href="https://kolkata.wordcamp.org/2025/speaker/amartya-gaur/" rel="noopener">Kolkata 2025</a>,
            <a href="https://delhi.wordcamp.org/2024/speaker/amartya-gaur/" rel="noopener">Delhi 2024</a>,
            <a href="https://ahmedabad.wordcamp.org/2023/mastering-gutenberg-blocks-from-basics-to-building-your-own-by-amartya-gaur/" rel="noopener">Ahmedabad 2023</a>.</li>
          <li><b>WordPress plugin development with the REST API and React</b> —
            <a href="https://mumbai.wordcamp.org/2023/speaker/amartya-gaur/" rel="noopener">WordCamp Mumbai 2023</a>.</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="writing" class="light sec writing">
    <div class="wrap">
      <p class="mono eyebrow rv">06 — writing</p>
      <h2 class="d d-2 rv">Notes from<br />the build</h2>
      <ul class="posts">
        {posts.map((p) => (
          <li class="rv">
            <a href={`/blog/${p.id}/`}>
              <span class="mono p-date">{fmt(p.data.date)}</span>
              <span class="d d-3 p-title">{p.data.title}</span>
              <span class="p-blurb">{p.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="cta" href="/blog">Everything I&rsquo;ve written<span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="contact" class="chamber sec contact">
    <div class="wrap">
      <p class="mono eyebrow rv">07 — contact</p>
      <h2 class="d d-2 rv">Tell me<br />what&rsquo;s breaking</h2>
      <p class="lede rv">If you&rsquo;re hiring engineers and the first screen isn&rsquo;t working, or you&rsquo;re building
        agents and the platform underneath them keeps giving way — that&rsquo;s the conversation I want.</p>
      <a class="d bigmail rv" href="mailto:amartya@hunr.ai">amartya@hunr.ai</a>
      <ul class="links mono rv">
        <li><a href="https://hunr.ai" rel="noopener">hunr.ai</a></li>
        <li><a href="https://github.com/amartya-dev" rel="me noopener">github.com/amartya-dev</a></li>
        <li><a href="https://linkedin.com/in/amartya-gaur" rel="me noopener">linkedin.com/in/amartya-gaur</a></li>
      </ul>
    </div>
  </section>

  <script>
    document.querySelectorAll('.span-row').forEach((row) => {
      row.addEventListener('click', () => {
        const open = row.getAttribute('aria-expanded') === 'true';
        const d = document.getElementById(row.getAttribute('aria-controls'));
        row.setAttribute('aria-expanded', String(!open));
        if (d) d.hidden = open;
      });
    });
  </script>
</Base>

<style>
  .sec :global(.d-2) { margin-bottom: 26px; }

  /* 01 — hunr */
  .loop {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1px; background: var(--rule); margin-top: clamp(44px, 6vw, 80px); border-block: 1px solid var(--rule);
  }
  .loop li { background: var(--paper); padding: 28px 24px 34px 0; }
  .loop li + li { padding-left: 24px; }
  .step { color: var(--fail); margin-bottom: 14px; }
  .loop p:last-child { font-size: .98rem; color: var(--ink-2); }

  .hunr-foot { display: flex; flex-wrap: wrap; gap: 32px 60px; align-items: flex-end; justify-content: space-between; margin-top: 44px; }
  .stats { display: flex; flex-wrap: wrap; gap: 26px 48px; }
  .stats dt { color: var(--mid); margin-bottom: 6px; }
  .stats dd { margin: 0; font-family: var(--display); font-weight: 800; font-stretch: 118%; font-size: 2.1rem; letter-spacing: -.02em; }
  .cta {
    font-family: var(--mono); font-size: .74rem; letter-spacing: .12em; text-transform: uppercase;
    text-decoration: none; border-bottom: 2px solid currentColor; padding-bottom: 6px;
    display: inline-flex; gap: 10px; align-items: center;
  }
  .cta span { transition: transform .25s ease; }
  .cta:hover span { transform: translateX(5px); }

  /* 03 — the record */
  .panel { margin-top: clamp(38px, 5vw, 60px); border: 1px solid var(--ink); }
  .axis { position: relative; height: 30px; margin-left: 280px; border-bottom: 1px solid var(--rule); color: var(--mid); }
  .axis span { position: absolute; left: calc(var(--t) * 100%); top: 9px; padding-left: 8px; border-left: 1px solid var(--rule); height: 21px; line-height: 1; font-size: .64rem; }
  .span + .span { border-top: 1px solid var(--rule); }
  .span-row {
    display: grid; grid-template-columns: 280px 1fr auto; gap: 16px; align-items: center; width: 100%;
    padding: 18px 20px 18px 0; background: none; border: 0; font: inherit; text-align: left; cursor: pointer; color: inherit;
  }
  .span-row:hover { background: var(--paper-2); }
  .sl { display: flex; flex-direction: column; gap: 3px; padding-left: 20px; }
  .sl b { font-family: var(--display); font-weight: 700; font-stretch: 112%; font-size: 1.02rem; text-transform: uppercase; letter-spacing: -.01em; }
  .sl i { font-style: normal; color: var(--mid); font-size: .82rem; line-height: 1.35; }
  .plot { position: relative; height: 13px; }
  .bar { position: absolute; inset-block: 0; left: calc(var(--s) * 100%); width: calc((var(--e) - var(--s)) * 100%); background: var(--ink); }
  .side .bar { background: none; border: 1px solid var(--ink); }
  .live .bar { background: var(--pass); }
  .dur { color: var(--mid); white-space: nowrap; font-size: .68rem; }
  .detail { padding: 0 20px 26px 300px; }
  .detail[hidden] { display: none; }
  .detail p { max-width: 74ch; color: var(--ink-2); font-size: .98rem; }
  .legend { border-top: 1px solid var(--rule); padding: 14px 20px; color: var(--mid); }

  .works { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1px; background: var(--rule); border: 1px solid var(--rule); margin-top: 40px; }
  .works li { background: var(--paper); padding: 30px 26px; }
  .w-org { color: var(--mid); margin-bottom: 14px; }
  .works h3 { margin-bottom: 12px; }
  .works p:last-child { font-size: .96rem; color: var(--ink-2); }

  /* 05 — in public */
  .contribs { margin-top: clamp(38px, 5vw, 56px); border-top: 1px solid var(--rule); }
  .contribs li { display: grid; grid-template-columns: 280px 1fr; gap: 22px; padding: 24px 0; border-bottom: 1px solid var(--rule); }
  .repo { display: flex; flex-direction: column; gap: 6px; }
  .repo a { text-decoration: none; border-bottom: 1px solid var(--rule); align-self: flex-start; }
  .repo a:hover { border-color: var(--ink); }
  .repo span { color: var(--mid); font-size: .64rem; }
  .contribs li > p + p { color: var(--ink-2); font-size: .98rem; }
  .contribs code { font-family: var(--mono); font-size: .85em; }
  .talks { margin-top: 46px; }
  .sub { color: var(--fail); margin-bottom: 16px; }
  .plain { display: grid; gap: 14px; max-width: 74ch; color: var(--ink-2); font-size: .98rem; }
  .plain b { font-weight: 600; color: var(--ink); }

  /* 06 — writing */
  .posts { margin-top: clamp(34px, 4vw, 52px); border-top: 1px solid var(--rule); }
  .posts li { border-bottom: 1px solid var(--rule); }
  .posts a { display: grid; grid-template-columns: 160px minmax(0, 1.1fr) minmax(0, 1fr); gap: 26px; align-items: baseline; padding: 26px 0; text-decoration: none; }
  .posts a:hover .p-title { color: var(--fail); }
  .p-date { color: var(--mid); }
  .p-title { transition: color .2s ease; }
  .p-blurb { color: var(--ink-2); font-size: .96rem; }
  .writing .cta { margin-top: 40px; }

  /* 07 — contact */
  .contact .lede { max-width: 42ch; }
  .bigmail {
    display: inline-block; margin-top: clamp(34px, 4vw, 52px); font-size: clamp(1.5rem, 5.6vw, 4.4rem);
    text-decoration: none; color: var(--bone); word-break: break-word; border-bottom: 3px solid var(--rule-dark);
  }
  .bigmail:hover { color: var(--pass-lit); border-color: var(--pass-lit); }
  .links { display: flex; flex-wrap: wrap; gap: 12px 32px; margin-top: 40px; color: var(--bone-dim); }
  .links a { text-decoration: none; }
  .links a:hover { color: var(--bone); }

  @media (max-width: 900px) {
    .axis { margin-left: 0; }
    .axis span:nth-child(even) { display: none; }
    .span-row { grid-template-columns: 1fr auto; row-gap: 12px; padding: 18px 20px; align-items: start; }
    .sl { padding-left: 0; grid-row: 1; }
    .dur { grid-row: 1; }
    .plot { grid-column: 1 / -1; }
    .detail { padding-left: 20px; }
    .contribs li, .posts a { grid-template-columns: 1fr; gap: 10px; }
    .loop li, .loop li + li { padding: 24px 0; }
  }
</style>
