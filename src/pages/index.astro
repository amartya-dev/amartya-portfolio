---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Ask from '../components/Ask.astro';
import Router from '../components/Router.astro';
import Refuse from '../components/Refuse.astro';
import Gate from '../components/Gate.astro';
import Units from '../components/Units.astro';
import Figure from '../components/Figure.astro';
import { PREVIEW } from '../data/previews.js';
import { getCollection } from 'astro:content';
import { P } from '../data/projects.js';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });

const FILTERS = [
  { k: 'all', l: 'All' },
  { k: 'agents', l: 'Agents' },
  { k: 'infra', l: 'Infrastructure' },
  { k: 'merged', l: 'Merged upstream' }
];
---
<Base>
  <Hero />

  <Ask />
  <Router />

  <section id="work" class="light sec">
    <div class="wrap">
      <p class="mono eyebrow rv">The record</p>
      <h2 class="d d-2 rv">Six years, five spans</h2>

      <div class="panel rv">
        <div class="axis mono" aria-hidden="true">
          <span style="--t:0">2020</span><span style="--t:.1429">2021</span><span style="--t:.2857">2022</span
          ><span style="--t:.4286">2023</span><span style="--t:.5714">2024</span><span style="--t:.7143">2025</span
          ><span style="--t:.857">2026</span>
        </div>
        <ol class="spans">
          <li class="span live" style="--s:.857;--e:.947">
            <div class="span-row">
              <span class="sl"><b>hunr.ai</b><i>Founder &amp; engineer</i></span>
              <span class="plot"><span class="bar"></span></span>
              <span class="mono dur">Since 2026</span>
            </div>
          </li>
          <li class="span" style="--s:.1786;--e:.947">
            <div class="span-row">
              <span class="sl"><b>Newfold Digital</b><i>Senior Software Developer, AI Center of Excellence</i></span>
              <span class="plot"><span class="bar"></span></span>
              <span class="mono dur">5y 5mo</span>
            </div>
          </li>
          <li class="span side" style="--s:.2857;--e:.7143">
            <div class="span-row">
              <span class="sl"><b>PayCrunch</b><i>Founding consultant, part-time</i></span>
              <span class="plot"><span class="bar"></span></span>
              <span class="mono dur">2022 – 2025</span>
            </div>
          </li>
          <li class="span side" style="--s:.857;--e:.947">
            <div class="span-row">
              <span class="sl"><b>Magicweave</b><i>Consulting on a friend&rsquo;s product</i></span>
              <span class="plot"><span class="bar"></span></span>
              <span class="mono dur">2026</span>
            </div>
          </li>
          <li class="span side" style="--s:.107;--e:.881">
            <div class="span-row">
              <span class="sl"><b>Ohuru Tech</b><i>Freelance and client work</i></span>
              <span class="plot"><span class="bar"></span></span>
              <span class="mono dur">2020 – 2026</span>
            </div>
          </li>
        </ol>
        <p class="legend mono">Solid bars were the main thing at the time. Hollow ones ran alongside.</p>
      </div>

      <div class="filters mono rv" role="group" aria-label="Filter">
        {FILTERS.map((f, i) => (
          <button type="button" class="chip" data-filter={f.k} aria-pressed={i === 0 ? 'true' : 'false'}>{f.l}</button>
        ))}
      </div>

      <ol class="projects">
        {P.map((p, i) => (
          <li class="proj rv" data-group={p.g} data-first={P.findIndex((q) => q.g === p.g) === i ? p.g : undefined}>
            <details>
              <summary>
                <span class="d d-3 p-name">{p.n}</span>
                <span class="p-hook">{p.h}</span>
                <span class="mono p-meta">{p.w}</span>
                <span class="mono p-year">{p.y}</span>
                <span class="mono p-status" data-s={p.s}>{p.s}</span>
              </summary>
              <div class="p-detail">
                <p>{p.d}</p>
                {p.href && <p class="mono p-link"><a href={p.href} rel="noopener">{p.href.replace('https://', '')}</a></p>}
                {p.widget === 'units' && <div class="p-widget"><Units /></div>}
              </div>
            </details>
          </li>
        ))}
      </ol>
      <p class="mono early rv">Earlier: American Express, Bruce Clay, a B.Tech from VIT, and four WordCamp talks I am
        contractually obliged to mention.</p>
    </div>
  </section>

  <Gate />
  <Refuse />

  <section id="writing" class="chamber sec">
    <div class="wrap">
      <p class="mono eyebrow rv">Writing</p>
      <h2 class="d d-2 rv">Working notes</h2>
      <ul class="posts rv">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              <span class="p-body">
                <span class="mono p-date">{fmt(p.data.date)}</span>
                <span class="p-title">{p.data.title}</span>
                <span class="p-blurb">{p.data.description}</span>
              </span>
              <Figure f={PREVIEW[p.id]} dark />
            </a>
          </li>
        ))}
      </ul>
      <a class="cta mono rv" href="/blog">All of it<span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="contact" class="light sec section-end">
    <div class="wrap">
      <p class="mono eyebrow rv">Contact</p>
      <h2 class="d d-2 rv">What&rsquo;s breaking?</h2>
      <p class="lede rv">Agents, evals, or the platform underneath. Either of those.</p>
      <a class="d bigmail rv" href="mailto:amartya@hunr.ai">amartya@hunr.ai</a>
      <ul class="links mono rv">
        <li><a href="https://hunr.ai" rel="noopener">hunr.ai</a></li>
        <li><a href="https://github.com/amartya-dev" rel="me noopener">github</a></li>
        <li><a href="https://linkedin.com/in/amartya-gaur" rel="me noopener">linkedin</a></li>
        <li><a href="/rss.xml">rss</a></li>
      </ul>
    </div>
  </section>

  <script>
    const chips = [...document.querySelectorAll('.chip')];
    const projects = [...document.querySelectorAll('.proj')];
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const key = chip.dataset.filter;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        projects.forEach((p) => { p.hidden = !(key === 'all' || p.dataset.group === key); });
      });
    });
  </script>
</Base>

<style>
  .panel { margin-top: var(--s-4); border: 1px solid var(--ink); }
  .axis { position: relative; height: 28px; margin-left: 280px; border-bottom: 1px solid var(--rule); color: var(--mid); }
  .axis span { position: absolute; left: calc(var(--t) * 100%); top: 8px; padding-left: 8px; border-left: 1px solid var(--rule); height: 20px; line-height: 1; font-size: 0.69rem; }
  .span + .span { border-top: 1px solid var(--rule); }
  .span-row { display: grid; grid-template-columns: 280px 1fr auto; gap: 16px; align-items: center; padding: 16px 20px 16px 0; }
  .sl { display: flex; flex-direction: column; gap: 3px; padding-left: 20px; }
  .sl b { font-family: var(--display); font-weight: 700; font-stretch: 112%; font-size: 1.16rem; line-height: 1.1; text-transform: uppercase; letter-spacing: -.012em; }
  .sl i { font-style: normal; color: var(--mid); font-size: var(--t-small); line-height: 1.35; }
  .plot { position: relative; height: 12px; }
  .bar { position: absolute; inset-block: 0; left: calc(var(--s) * 100%); width: calc((var(--e) - var(--s)) * 100%); background: var(--ink); }
  .side .bar { background: none; border: 1px solid var(--ink); }
  .live .bar { background: var(--pass); }
  .dur { color: var(--mid); font-size: 0.69rem; }

  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: var(--s-5); }
  .chip { font: inherit; cursor: pointer; background: none; color: var(--mid); border: 1px solid var(--rule); padding: 9px 16px; transition: all .18s ease; }
  .chip:hover { border-color: var(--ink); color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--paper); }

  .projects { margin-top: var(--s-3); border-top: 1px solid var(--ink); }
  /* A rule and a label where each group starts, so the list reads as three lists. */
  .proj[data-first]::before {
    display: block; content: attr(data-first);
    font-family: var(--mono); font-size: 0.69rem; letter-spacing: .16em; text-transform: uppercase;
    color: var(--fail-ink); padding: 30px 0 12px;
  }
  .proj[data-first='agents']::before { content: 'Agent systems'; }
  .proj[data-first='infra']::before { content: 'Infrastructure'; }
  .proj[data-first='merged']::before { content: 'Merged into other repositories'; }
  .proj[data-first][hidden]::before { display: none; }
  .proj { border-bottom: 1px solid var(--rule); }
  .proj[hidden] { display: none; }
  .proj details { display: block; }
  /* Five columns and a sign, so the status chip sits on the row it belongs to
     and the row admits it opens. */
  .proj summary {
    display: grid; grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) 10.5rem 5.6rem 9.2rem 1.2rem;
    gap: var(--s-1) 20px; align-items: baseline; padding: 18px 0; cursor: pointer; list-style: none;
    transition: background .15s ease;
  }
  .proj summary::-webkit-details-marker { display: none; }
  .proj summary::after {
    content: "+"; font-family: var(--mono); font-size: .95rem; line-height: 1;
    color: var(--mid); justify-self: end; transition: color .15s ease;
  }
  .proj[open] summary::after { content: "\2212"; color: var(--fail); }
  .proj summary:hover::after { color: var(--fail); }
  .proj summary:hover { background: var(--paper-2); }
  .proj summary:hover .p-name { color: var(--fail); }
  .proj[open] summary { padding-bottom: 8px; }
  .p-name { font-size: 1.24rem; line-height: 1.08; transition: color .15s ease; }
  .p-hook { color: var(--ink-2); font-size: var(--t-body); }
  .p-meta { color: var(--mid); font-size: var(--t-micro); }
  .p-year { color: var(--mid); font-size: var(--t-micro); text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .p-detail { padding: 2px 0 var(--s-3); max-width: 68ch; }
  .p-detail p { color: var(--ink-2); font-size: var(--t-small); }
  .p-link { margin-top: 12px; }
  .p-link a { color: var(--fail-ink); }
  .p-name { display: inline-flex; gap: .3em; align-items: baseline; text-decoration: none; }
  a.p-name:hover { color: var(--fail); }
  .ext { font-size: .5em; opacity: .55; }
  .p-status {
    justify-self: start; padding: 3px 8px; font-size: 0.69rem; white-space: nowrap;
    border: 1px solid var(--rule); color: var(--mid); line-height: 1.5;
  }
  .p-status[data-s^='Live'], .p-status[data-s^='In production'], .p-status[data-s^='Shipped'] { border-color: var(--pass); color: var(--pass); }
  .p-status[data-s^='Merged'] { border-color: var(--ink); color: var(--ink); }
  .p-status[data-s^='Unpublished'], .p-status[data-s^='Private'] { border-style: dashed; }
  .p-body p { color: var(--ink-2); font-size: .98rem; max-width: 68ch; }
  .p-widget { margin-top: 20px; max-width: 560px; }
  .early { margin-top: var(--s-4); color: var(--mid); text-transform: none; letter-spacing: .03em; max-width: 70ch; line-height: 1.75; font-size: var(--t-small); }

  .posts { border-top: 1px solid var(--rule-dark); margin-top: clamp(30px, 4vw, 48px); }
  .posts li { border-bottom: 1px solid var(--rule-dark); }
  .posts a { display: grid; grid-template-columns: minmax(0, 1fr) 190px; gap: 40px; align-items: center; padding: 26px 0; text-decoration: none; }
  .p-body { display: grid; gap: 9px; max-width: 58ch; }
  .p-date { color: var(--bone-dim); font-size: .72rem; letter-spacing: .02em; text-transform: none; }
  .p-title { font-family: var(--display); font-weight: 700; font-stretch: 112%; text-transform: uppercase; letter-spacing: -.015em; font-size: 1.3rem; line-height: 1.08; color: var(--bone); transition: color .2s ease; }
  .posts a:hover .p-title { color: var(--pass-lit); text-decoration: underline; text-underline-offset: .16em; }
  .p-blurb { color: var(--bone-dim); font-size: var(--t-small); }
  @media (max-width: 860px) { .posts a { grid-template-columns: 1fr; gap: 16px; } .posts a :global(.fig) { max-width: 210px; } }
  .cta { display: inline-flex; gap: 10px; align-items: center; margin-top: 26px; text-decoration: none; color: var(--bone-dim); border-bottom: 1px solid currentColor; padding-bottom: 5px; }
  .cta:hover { color: var(--bone); }
  .cta span { transition: transform .25s ease; }
  .cta:hover span { transform: translateX(5px); }

  .bigmail { display: inline-block; margin-top: clamp(28px, 4vw, 44px); font-size: clamp(1.4rem, 4.8vw, 3.4rem); text-decoration: none; color: var(--ink); word-break: break-word; border-bottom: 3px solid var(--rule); }
  .bigmail:hover { color: var(--fail); border-color: var(--fail); }
  .links { display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 34px; color: var(--mid); }
  .links a:hover { color: var(--fail-ink); }

  @media (max-width: 900px) {
    .axis { margin-left: 0; }
    .axis span:nth-child(even) { display: none; }
    .span-row { grid-template-columns: 1fr auto; row-gap: 10px; padding: 16px 20px; align-items: start; }
    .sl { padding-left: 0; grid-row: 1; }
    .dur { grid-row: 1; }
    .plot { grid-column: 1 / -1; }
  }

  /* Under 1080 the five columns stop fitting, so the row becomes a stack:
     name and sign, hook, who and when, then the status chip. */
  @media (max-width: 1080px) {
    .proj summary {
      grid-template-columns: minmax(0, 1fr) 1.2rem;
      grid-template-areas: 'name sign' 'hook hook' 'meta year' 'stat stat';
      gap: 10px 20px; align-items: start;
    }
    .p-name { grid-area: name; }
    .p-hook { grid-area: hook; }
    .p-meta { grid-area: meta; }
    .p-year { grid-area: year; text-align: right; }
    .p-status { grid-area: stat; margin-top: 4px; }
    .proj summary::after { grid-area: sign; }
  }
</style>
