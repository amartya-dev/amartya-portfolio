---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Router from '../components/Router.astro';
import Refuse from '../components/Refuse.astro';
import Gate from '../components/Gate.astro';
import Units from '../components/Units.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });

const P = [
  { g: 'agents', n: 'hunr.ai', w: 'Founder', y: '2026 —', href: 'https://hunr.ai',
    d: 'Screening that hands candidates a real repo, lets them use any agent, then checks they can defend it. Grading sandboxes, network namespaces, OTel tracing, GitOps digest pinning. Built solo.' },
  { g: 'agents', n: 'State-conditioned routing', w: 'Research', y: '2026',
    d: 'Forty-nine commits spent trying to falsify a routing design I had already shipped. Pre-registered hypotheses, kill criteria, and a published correction when my own estimator turned out to have a substring bug.' },
  { g: 'agents', n: 'Ella', w: 'Proof of concept', y: '2026',
    d: 'An analytics agent for creators on six platforms, over a data layer that refuses to return a figure whose unit is undefined. It would rather argue than average a TikTok second into a YouTube minute.' },
  { g: 'agents', n: 'ax — agent asset registry', w: 'Tooling', y: '2026',
    d: 'Agents produce scripts and queries nobody can vouch for later. This keeps them with their provenance and marks them suspect the moment the thing they were derived from changes.' },
  { g: 'agents', n: 'manu docs', w: 'Open source', y: '2026',
    d: 'Point it at a repo and get a documentation site plus two MCP servers that keep themselves current. Pre-alpha, and says so loudly.' },
  { g: 'agents', n: 'Agent orchestration framework', w: 'Newfold Digital', y: '2024 – 2026',
    d: 'A sticky state machine with a workflow registry, carrying the production support agents for Network Solutions and BigRock at roughly a thousand conversations an hour.' },
  { g: 'agents', n: 'Evals with a deploy gate', w: 'Newfold Digital', y: '2024 – 2026',
    d: '739 regression cases, ~2,700 assertions, ~250 scoring metrics — wired into Jenkins as a blocking gate. Deterministic assertions can fail a build; model-judged ones report and stay out of the way.' },
  { g: 'agents', n: 'AI-native website builder', w: 'Newfold Digital', y: '2023 – 2025',
    d: 'Prompt to live hosted site. LangGraph generation harness, sandbox orchestration, atomic publishes across OCI and Cloudflare. 149 of 334 commits; time to first preview down 48%.' },
  { g: 'infra', n: 'Public MCP server for deploys', w: 'Newfold Digital', y: '2026',
    d: 'Ship to a managed VPS from Claude Code or Codex. Infrastructure, DevOps, the tool interface, and Cloudflare Enterprise endpoint authorisation.' },
  { g: 'infra', n: 'Typesense, all four layers', w: 'Open source', y: '2025', href: 'https://github.com/amartya-dev/typesense-helm',
    d: 'A registry mirror, a Helm chart running a three-replica Raft cluster with per-pod DNS, an admin dashboard, and the indexer that feeds it. The chart is hardened for OpenShift because it had to be.' },
  { g: 'infra', n: 'Microsoft 365 to NCE', w: 'Newfold Digital', y: '2021 – 2023',
    d: 'About 100,000 accounts migrated, and the async systems underneath rebuilt to survive low-memory hosting.' },
  { g: 'infra', n: 'UPI credit lending backend', w: 'PayCrunch', y: '2022 – 2025',
    d: 'The backend from zero for a YC-backed fintech: lending and payment rail integrations with underwriting on top, plus the Flutter client. Hired and led the first three engineers.' },
  { g: 'infra', n: 'Jeet Kune Do Federation of India', w: 'Pro bono', y: '2026',
    d: 'Next.js on Cloud Run in Mumbai with Cloudflare in front. The seeds refuse to overwrite anything an admin has since edited, which is the only interesting sentence in a website.' },
  { g: 'merged', n: 'Textualize/rich', w: 'Merged · 57k stars', y: '2020', href: 'https://github.com/Textualize/rich/pull/380',
    d: 'Twenty-nine lines that let a download column render binary units. It is the smallest thing on this page and by far the most installed.', widget: 'units' },
  { g: 'merged', n: 'OpenMontage', w: 'Merged · 49k stars', y: '2026', href: 'https://github.com/calesthio/OpenMontage/pull/354',
    d: 'Azure AI Speech as an optional provider, twice: speech-to-text and text-to-speech, about 900 lines each. A repo-grounded product-motion pipeline is open at 4,316 lines.' },
  { g: 'merged', n: 'neta-resume', w: 'Merged', y: '2026', href: 'https://github.com/citizen-apps-india/neta-resume',
    d: 'A production AWS and GitOps platform, and a portable ingestion control plane, for a civic-tech project.' },
  { g: 'merged', n: 'Creative Commons cccatalog', w: 'Merged · now Openverse', y: '2020', href: 'https://github.com/cc-archive/cccatalog/pull/344',
    d: 'Test-on-pull-request CI, and tag blacklisting in the image store.' }
];

const FILTERS = [
  { k: 'all', l: 'All' },
  { k: 'agents', l: 'Agents' },
  { k: 'infra', l: 'Infrastructure' },
  { k: 'merged', l: 'Merged upstream' }
];
---
<Base>
  <Hero />

  <section id="what" class="light sec">
    <div class="wrap">
      <p class="mono eyebrow rv">What I do</p>
      <h2 class="d d-2 rv">I build systems<br />that hold a line</h2>
      <p class="lede rv">Routing that won&rsquo;t change its mind. Evals that can fail a build. A data layer that
        would rather argue than hand you a wrong number. Three of them are below — go on, break them.</p>
    </div>
  </section>

  <Router />
  <Refuse />
  <Gate />

  <section id="work" class="light sec">
    <div class="wrap">
      <p class="mono eyebrow rv">The record</p>
      <h2 class="d d-2 rv">Five years,<br />three spans</h2>

      <div class="panel rv">
        <div class="axis mono" aria-hidden="true">
          <span style="--t:0">2021</span><span style="--t:.1667">2022</span><span style="--t:.3333">2023</span
          ><span style="--t:.5">2024</span><span style="--t:.6667">2025</span><span style="--t:.8333">2026</span>
        </div>
        <ol class="spans">
          <li class="span" style="--s:.0417;--e:.938">
            <div class="span-row">
              <span class="sl"><b>Newfold Digital</b><i>Senior Software Developer, AI Center of Excellence</i></span>
              <span class="plot"><span class="bar"></span></span>
              <span class="mono dur">5y 5mo</span>
            </div>
          </li>
          <li class="span side" style="--s:.1667;--e:.6667">
            <div class="span-row">
              <span class="sl"><b>PayCrunch</b><i>Founding consultant, part-time</i></span>
              <span class="plot"><span class="bar"></span></span>
              <span class="mono dur">2022 – 2025</span>
            </div>
          </li>
          <li class="span live" style="--s:.8333;--e:.938">
            <div class="span-row">
              <span class="sl"><b>hunr.ai</b><i>Founder &amp; engineer</i></span>
              <span class="plot"><span class="bar"></span></span>
              <span class="mono dur">2026 —</span>
            </div>
          </li>
        </ol>
      </div>

      <div class="filters mono rv" role="group" aria-label="Filter">
        {FILTERS.map((f, i) => (
          <button type="button" class="chip" data-filter={f.k} aria-pressed={i === 0 ? 'true' : 'false'}>{f.l}</button>
        ))}
      </div>

      <ol class="projects">
        {P.map((p) => (
          <li class="proj rv" data-group={p.g}>
            <div class="p-id">
              {p.href
                ? <a class="d d-3 p-name" href={p.href} rel="noopener">{p.n}<span class="ext" aria-hidden="true">↗</span></a>
                : <span class="d d-3 p-name">{p.n}</span>}
              <p class="mono p-meta">{p.w} · {p.y}</p>
            </div>
            <div class="p-body">
              <p>{p.d}</p>
              {p.widget === 'units' && <div class="p-widget"><Units /></div>}
            </div>
          </li>
        ))}
      </ol>
      <p class="mono early rv">Before: internships at American Express and Bruce Clay, a B.Tech from VIT, and four
        WordCamp talks I am contractually obliged to mention.</p>
    </div>
  </section>

  <section id="end" class="chamber sec">
    <div class="wrap">
      <div class="end-grid">
        <div>
          <p class="mono eyebrow rv">Writing</p>
          <ul class="posts rv">
            {posts.map((p) => (
              <li>
                <a href={`/blog/${p.id}/`}>
                  <span class="mono p-date">{fmt(p.data.date)}</span>
                  <span class="p-title">{p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="cta mono rv" href="/blog">All of it<span aria-hidden="true">→</span></a>
        </div>
        <div id="contact">
          <p class="mono eyebrow rv">Contact</p>
          <h2 class="d d-2 rv">Tell me<br />what&rsquo;s breaking</h2>
          <a class="d bigmail rv" href="mailto:amartya@hunr.ai">amartya@hunr.ai</a>
          <ul class="links mono rv">
            <li><a href="https://hunr.ai" rel="noopener">hunr.ai</a></li>
            <li><a href="https://github.com/amartya-dev" rel="me noopener">github</a></li>
            <li><a href="https://linkedin.com/in/amartya-gaur" rel="me noopener">linkedin</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <script>
    const chips = [...document.querySelectorAll('.chip')];
    const projects = [...document.querySelectorAll('.proj')];
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const key = chip.dataset.filter;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        projects.forEach((p) => { p.hidden = !(key === 'all' || p.dataset.group === key); });
      });
    });
  </script>
</Base>

<style>
  .sec :global(.d-2) { margin-bottom: 26px; }
  #what .lede { max-width: 44ch; }

  .panel { margin-top: clamp(30px, 4vw, 48px); border: 1px solid var(--ink); }
  .axis { position: relative; height: 28px; margin-left: 280px; border-bottom: 1px solid var(--rule); color: var(--mid); }
  .axis span { position: absolute; left: calc(var(--t) * 100%); top: 8px; padding-left: 8px; border-left: 1px solid var(--rule); height: 20px; line-height: 1; font-size: .62rem; }
  .span + .span { border-top: 1px solid var(--rule); }
  .span-row { display: grid; grid-template-columns: 280px 1fr auto; gap: 16px; align-items: center; padding: 16px 20px 16px 0; }
  .sl { display: flex; flex-direction: column; gap: 3px; padding-left: 20px; }
  .sl b { font-family: var(--display); font-weight: 700; font-stretch: 112%; font-size: 1rem; text-transform: uppercase; letter-spacing: -.01em; }
  .sl i { font-style: normal; color: var(--mid); font-size: .8rem; }
  .plot { position: relative; height: 12px; }
  .bar { position: absolute; inset-block: 0; left: calc(var(--s) * 100%); width: calc((var(--e) - var(--s)) * 100%); background: var(--ink); }
  .side .bar { background: none; border: 1px solid var(--ink); }
  .live .bar { background: var(--pass); }
  .dur { color: var(--mid); font-size: .66rem; }

  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: clamp(40px, 5vw, 64px); }
  .chip { font: inherit; cursor: pointer; background: none; color: var(--mid); border: 1px solid var(--rule); padding: 9px 16px; transition: all .18s ease; }
  .chip:hover { border-color: var(--ink); color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--paper); }

  .projects { margin-top: 26px; border-top: 1px solid var(--rule); }
  .proj { display: grid; grid-template-columns: 300px 1fr; gap: 26px; padding: 26px 0; border-bottom: 1px solid var(--rule); }
  .proj[hidden] { display: none; }
  .p-name { display: inline-flex; gap: .3em; align-items: baseline; text-decoration: none; }
  a.p-name:hover { color: var(--fail); }
  .ext { font-size: .5em; opacity: .55; }
  .p-meta { color: var(--mid); margin-top: 9px; }
  .p-body p { color: var(--ink-2); font-size: .98rem; max-width: 68ch; }
  .p-widget { margin-top: 20px; max-width: 560px; }
  .early { margin-top: 34px; color: var(--mid); text-transform: none; letter-spacing: .03em; max-width: 70ch; line-height: 1.8; }

  .end-grid { display: grid; gap: clamp(48px, 7vw, 96px); }
  @media (min-width: 940px) { .end-grid { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); } }
  .posts { border-top: 1px solid var(--rule-dark); }
  .posts li { border-bottom: 1px solid var(--rule-dark); }
  .posts a { display: grid; gap: 8px; padding: 18px 0; text-decoration: none; }
  .p-date { color: var(--bone-dim); }
  .p-title { font-size: 1.05rem; color: var(--bone); transition: color .2s ease; }
  .posts a:hover .p-title { color: var(--pass-lit); }
  .cta { display: inline-flex; gap: 10px; align-items: center; margin-top: 26px; text-decoration: none; color: var(--bone-dim); border-bottom: 1px solid currentColor; padding-bottom: 5px; }
  .cta:hover { color: var(--bone); }
  .cta span { transition: transform .25s ease; }
  .cta:hover span { transform: translateX(5px); }

  .bigmail { display: inline-block; margin-top: 8px; font-size: clamp(1.4rem, 4.4vw, 3rem); text-decoration: none; color: var(--bone); word-break: break-word; border-bottom: 3px solid var(--rule-dark); }
  .bigmail:hover { color: var(--pass-lit); border-color: var(--pass-lit); }
  .links { display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 32px; color: var(--bone-dim); }
  .links a { text-decoration: none; }
  .links a:hover { color: var(--bone); }

  @media (max-width: 900px) {
    .axis { margin-left: 0; }
    .axis span:nth-child(even) { display: none; }
    .span-row { grid-template-columns: 1fr auto; row-gap: 10px; padding: 16px 20px; align-items: start; }
    .sl { padding-left: 0; grid-row: 1; }
    .dur { grid-row: 1; }
    .plot { grid-column: 1 / -1; }
    .proj { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
