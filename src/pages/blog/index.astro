---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Figure from '../../components/Figure.astro';
import { PREVIEW } from '../../data/previews.js';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

---
<Base title="Writing · Amartya Gaur" description="Notes on agent orchestration, evals, and technical hiring, by Amartya Gaur." theme="light">
  <section class="light sec index">
    <div class="graticule" aria-hidden="true"></div>
    <div class="wrap">
      <h1 class="d d-2">Notes from the build</h1>

      <ol class="list">
        {posts.map((p, i) => {
          const f = PREVIEW[p.id];
          return (
            <li class={i === 0 ? 'first' : ''}>
              <a href={`/blog/${p.id}/`}>
                <span class="body">
                  <span class="date">{fmt(p.data.date)} · {p.data.tags.join(', ')}</span>
                  <span class="d d-3 title">{p.data.title}</span>
                  <span class="blurb">{p.data.description}</span>
                </span>

                <Figure f={f} />
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>
</Base>

<style>
  .index { padding-top: clamp(120px, 14vw, 190px); padding-bottom: var(--s-5); position: relative; overflow: hidden; }
  .index > * { position: relative; z-index: 1; }
  .index > .graticule {
    -webkit-mask-image: radial-gradient(85% 45% at 50% 14%, #000 6%, transparent 78%);
    mask-image: radial-gradient(85% 45% at 50% 14%, #000 6%, transparent 78%);
  }
  .list { margin-top: clamp(34px, 4.5vw, 56px); border-top: 1px solid var(--ink); }
  .list li { border-bottom: 1px solid var(--rule); }
  .list a {
    display: grid; grid-template-columns: minmax(0, 1fr) 210px; gap: 40px;
    align-items: center; padding: 30px 0; text-decoration: none;
  }
  .body { display: grid; gap: 10px; max-width: 60ch; }
  .date { color: var(--mid); font-family: var(--mono); font-size: .72rem; letter-spacing: .02em; }
  .title { transition: color .18s ease; }
  .list a:hover .title { color: var(--fail-ink); text-decoration: underline; text-underline-offset: .16em; }
  .blurb { color: var(--ink-2); font-size: var(--t-small); line-height: 1.6; }

  /* The newest one gets the room. A list where every row carries the same weight
     is a list nobody edited. */
  .first a { padding: 10px 0 38px; grid-template-columns: minmax(0, 1fr) 260px; }
  .first .title { font-size: clamp(1.75rem, 3.4vw, 2.6rem); }
  .first .blurb { font-size: var(--t-body); }


  @media (max-width: 820px) {
    .list a, .first a { grid-template-columns: 1fr; gap: 18px; }
    .list a :global(.fig) { max-width: 230px; }
  }
</style>
