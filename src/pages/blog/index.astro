---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Writing — Amartya Gaur" description="Notes on agent orchestration, evals, and technical hiring, by Amartya Gaur." theme="light">
  <section class="light sec index">
    <div class="wrap">
      <p class="mono eyebrow">Writing</p>
      <h1 class="d d-2">Notes from<br />the build</h1>
      <p class="lede">Agent orchestration, evaluation that can fail a deploy, and what technical hiring
        looks like once you stop pretending candidates aren&rsquo;t using AI.</p>

      <ul class="list">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>
              <span class="mono date">{fmt(p.data.date)}</span>
              <span class="body">
                <span class="d d-3 title">{p.data.title}</span>
                <span class="blurb">{p.data.description}</span>
                <span class="mono tags">{p.data.tags.join(' · ')}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .index { padding-top: clamp(120px, 14vw, 200px); }
  .index .lede { max-width: 44ch; }
  .list { margin-top: clamp(44px, 6vw, 76px); border-top: 1px solid var(--rule); }
  .list li { border-bottom: 1px solid var(--rule); }
  .list a { display: grid; grid-template-columns: 220px 1fr; gap: 30px; padding: 34px 0; text-decoration: none; }
  .date { color: var(--mid); padding-top: 6px; }
  .body { display: grid; gap: 12px; max-width: 62ch; }
  .title { transition: color .2s ease; }
  .list a:hover .title { color: var(--fail); }
  .blurb { color: var(--ink-2); }
  .tags { color: var(--mid); }
  @media (max-width: 760px) { .list a { grid-template-columns: 1fr; gap: 14px; } }
</style>
