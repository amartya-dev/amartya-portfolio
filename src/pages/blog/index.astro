---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Figure from '../../components/Figure.astro';
import { PREVIEW } from '../../data/previews.js';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Writing · Amartya Gaur" description="Notes on agent orchestration, evals, and technical hiring, by Amartya Gaur." theme="light">
  <section class="light sec index">
    <div class="wrap">
      <div class="flowline" aria-hidden="true"></div>
      <div class="spread">
        <div class="rail" aria-hidden="true">
          <span class="railhead"><span class="no">§</span><span class="lbl">Writing</span></span>
          <span class="note">Each figure is drawn from that post&rsquo;s own numbers. Posts without a
            measurement in them get none, which is what stops this being a grid of tiles.</span>
        </div>
        <div class="col">
          <h1 class="d d-2">Notes from the build</h1>
          <p class="lede">Agent orchestration, evals that can fail a deploy, and what happens when a
            benchmark turns out to be measuring nothing.</p>

          <ol class="list">
            {posts.map((p, i) => (
              <li class={i === 0 ? 'first' : ''}>
                <a href={`/blog/${p.id}/`}>
                  <span class="body">
                    <span class="date mono">{fmt(p.data.date)}<span class="sep" aria-hidden="true">·</span>{p.data.tags.join(', ')}</span>
                    <span class="title d">{p.data.title}</span>
                    <span class="blurb">{p.data.description}</span>
                  </span>
                  <Figure f={PREVIEW[p.id]} />
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .index { padding-top: clamp(118px, 13vw, 178px); padding-bottom: var(--s-6); }
  .lede { max-width: 40ch; }

  .list { margin-top: clamp(40px, 5vw, 64px); border-top: 1px solid var(--ink); }
  .list li { border-bottom: 1px solid var(--rule); }
  .list a {
    display: grid; grid-template-columns: minmax(0, 1fr) 200px; gap: 44px;
    align-items: center; padding: 28px 0; text-decoration: none;
  }
  .body { display: grid; gap: 9px; max-width: 58ch; }
  .date { color: var(--mid); font-size: var(--t-micro); letter-spacing: .06em; text-transform: uppercase; }
  .sep { padding: 0 .45em; }
  .title {
    font-size: clamp(1.3rem, 2.1vw, 1.7rem); font-weight: 400;
    letter-spacing: -.016em; line-height: 1.16; transition: color .16s ease;
  }
  .list a:hover .title { color: var(--fail-ink); }
  .blurb { color: var(--ink-2); font-size: var(--t-small); line-height: 1.65; }

  /* The newest one gets the room. A list where every row carries the same weight
     is a list nobody edited. */
  .first a { padding: 8px 0 36px; grid-template-columns: minmax(0, 1fr) 250px; }
  .first .title { font-size: clamp(1.9rem, 3.6vw, 2.9rem); line-height: 1.08; }
  .first .blurb { font-size: var(--t-body); }

  @media (max-width: 820px) {
    .list a, .first a { grid-template-columns: 1fr; gap: 18px; }
    .list a :global(.fig) { max-width: 230px; }
  }
</style>
