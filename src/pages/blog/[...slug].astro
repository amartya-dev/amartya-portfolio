---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={`${post.data.title} — Amartya Gaur`} description={post.data.description} theme="light">
  <article class="light sec post">
    <div class="wrap">
      <a class="mono back" href="/blog">← Writing</a>
      <p class="mono meta">{fmt(post.data.date)} · {post.data.tags.join(' · ')}</p>
      <h1 class="d d-2">{post.data.title}</h1>
      <p class="stand">{post.data.description}</p>
      <div class="prose"><Content /></div>
      <footer class="end">
        <p class="mono">Written by Amartya Gaur — building <a href="https://hunr.ai" rel="noopener">hunr.ai</a>.</p>
        <a class="mono back" href="/blog">← More writing</a>
      </footer>
    </div>
  </article>
</Base>

<style>
  .post { padding-top: clamp(110px, 13vw, 180px); }
  .wrap { max-width: 880px; }
  .back { color: var(--mid); text-decoration: none; display: inline-block; }
  .back:hover { color: var(--ink); }
  .meta { color: var(--mid); margin: var(--s-4) 0 var(--s-2); }
  .post :global(.d-2) { font-size: clamp(1.9rem, 4.6vw, 3.5rem); }
  .stand { font-size: var(--t-lede); line-height: 1.42; color: var(--ink-2); font-style: italic; }
  .prose { margin-top: var(--s-5); }
  .prose :global(p) { margin-bottom: 1.3em; }
  .prose :global(h2) {
    font-family: var(--display); font-weight: 800; font-stretch: 116%; text-transform: uppercase;
    font-size: 1.35rem; letter-spacing: -.01em; margin: 2.4em 0 .9em; line-height: 1.1;
  }
  .prose :global(ul) { list-style: none; margin: 0 0 1.4em; padding: 0; display: grid; gap: .7em; }
  .prose :global(li) { padding-left: 22px; position: relative; }
  .prose :global(li)::before { content: ""; position: absolute; left: 0; top: .68em; width: 10px; height: 1px; background: var(--fail); }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(code) { font-family: var(--mono); font-size: .82em; background: var(--paper-2); padding: 2px 5px; }
  .prose :global(pre) {
    font-family: var(--mono); font-size: .78rem; line-height: 1.8; background: var(--void); color: var(--bone);
    padding: 22px 24px; overflow-x: auto; margin: 1.8em 0;
  }
  .prose :global(pre code) { background: none; padding: 0; font-size: inherit; }
  .prose :global(a) { color: var(--fail); }
  .end { margin-top: clamp(56px, 7vw, 90px); padding-top: 26px; border-top: 1px solid var(--rule); display: flex; flex-wrap: wrap; gap: 16px 30px; justify-content: space-between; color: var(--mid); }
  .end a { color: inherit; }
</style>
