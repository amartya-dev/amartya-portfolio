---
// The essay page. The one surface on this site whose whole job is reading.
//
// It used to set its headings in the display face at weight 800, width 116%,
// in capitals — a poster treatment applied to every subhead in a two-thousand
// word article. And the body was the same neutral sans as the navigation, at
// the same size, so nothing marked the difference between the interface and the
// argument.
//
// Now the argument is set in the reading serif at 19/33 on a 66-character
// measure, and the interface around it stays sans. The date, tags and length go
// out to the margin rail where a printed article puts them.
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
// Counted, not guessed. Everything else on this site is a measurement; there is
// no reason for this one to be a shrug.
const words = (post.body || '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 225));
---
<Base title={`${post.data.title} · Amartya Gaur`} description={post.data.description} theme="light" og={post.id}>
  <article class="light sec post">
    <div class="wrap">
      <div class="flowline" aria-hidden="true"></div>
      <div class="spread">
        <div class="rail">
          <span class="railhead">
            <span class="no" aria-hidden="true">¶</span>
            <span class="lbl">{fmt(post.data.date)}</span>
          </span>
          <span class="note">
            {post.data.tags.join(' · ')}<br />
            {minutes} min · {words.toLocaleString('en-GB')} words
          </span>
        </div>

        <div class="col">
          <a class="back" href="/blog">← Writing</a>
          <h1 class="d">{post.data.title}</h1>
          <p class="stand">{post.data.description}</p>
          <div class="prose"><Content /></div>

          <footer class="end">
            <p>Written by Amartya Gaur, building <a href="https://hunr.ai" rel="noopener">hunr.ai</a>.</p>
            <a class="back" href="/blog">← More writing</a>
          </footer>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .post { padding-top: clamp(118px, 13vw, 178px); }
  .col { max-width: 68ch; }

  .back { display: inline-block; font-size: var(--t-small); font-weight: 500; color: var(--mid); text-decoration: none; }
  .back:hover { color: var(--fail-ink); }

  h1 {
    margin-top: var(--s-4);
    font-size: clamp(2.1rem, 5vw, 3.6rem); font-weight: 400;
    letter-spacing: -.024em; line-height: 1.03;
  }
  /* The standfirst. Italic serif, one notch up from the body, which is exactly
     how a set article marks the sentence that tells you whether to read on. */
  .stand {
    margin-top: var(--s-3);
    font-family: var(--display); font-optical-sizing: auto;
    font-style: italic; font-weight: 380;
    font-size: clamp(1.25rem, 2vw, 1.55rem); line-height: 1.42; letter-spacing: -.008em;
    color: var(--ink-2); max-width: 46ch;
  }

  /* ------------------------------------------------------------------------
     The prose. Serif, 19/33, 66 characters. Everything below exists to keep
     that measure and that rhythm intact.
     ------------------------------------------------------------------------ */
  .prose {
    margin-top: clamp(46px, 6vw, 74px);
    font-family: var(--display); font-optical-sizing: auto;
    font-size: 1.1875rem; line-height: 1.72; letter-spacing: -.002em;
    color: var(--ink);
    max-width: 66ch;
  }
  .prose :global(p) { margin-bottom: 1.15em; text-wrap: pretty; }

  /* Subheads are the reading serif at a size, not the display face in capitals
     at weight 800. A serif subhead with air above it is unmistakable without
     shouting, and it keeps the article in one voice. */
  .prose :global(h2) {
    font-family: var(--display); font-weight: 500; font-size: 1.65rem;
    letter-spacing: -.016em; line-height: 1.18; margin: 2.2em 0 .7em;
    text-wrap: balance;
  }
  .prose :global(h3) {
    font-family: var(--body); font-weight: 600; font-size: var(--t-label);
    letter-spacing: .1em; text-transform: uppercase; color: var(--mid);
    margin: 2em 0 .6em; line-height: 1.4;
  }

  /* Hanging bullets: an en-rule in the accent, out in the margin, so the list
     text keeps the same left edge as the paragraphs around it. */
  .prose :global(ul) { list-style: none; margin: 0 0 1.35em; padding: 0; display: grid; gap: .6em; }
  .prose :global(ul > li) { padding-left: 26px; position: relative; }
  .prose :global(ul > li)::before {
    content: ""; position: absolute; left: 0; top: .82em;
    width: 13px; height: 1px; background: var(--fail-ink);
  }
  .prose :global(ol) { list-style: none; margin: 0 0 1.35em; padding: 0; display: grid; gap: .6em; counter-reset: step; }
  .prose :global(ol > li) { padding-left: 32px; position: relative; counter-increment: step; }
  .prose :global(ol > li)::before {
    content: counter(step) "."; position: absolute; left: 0; top: 0;
    font-style: italic; color: var(--fail-ink); font-variant-numeric: tabular-nums;
  }

  /* A pull quote, set the way a book sets one: indented and italic, with no
     border. The rule down the left was doing the work the indent already does. */
  .prose :global(blockquote) {
    margin: 1.8em 0; padding-left: 1.6em;
    font-style: italic; font-size: 1.28rem; line-height: 1.5; color: var(--ink-2);
  }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(blockquote p + p) { margin-top: .55em; }

  /* A section break is an asterism, not a line across the column. */
  .prose :global(hr) {
    border: 0; margin: 2.4em 0; text-align: center; height: auto;
  }
  .prose :global(hr)::before {
    content: "❊"; color: var(--mid); font-size: .9rem; letter-spacing: .5em;
  }

  .prose :global(img) { margin: 1.8em 0; border: 1px solid var(--rule); border-radius: var(--r); }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(em) { font-style: italic; }
  .prose :global(a) { color: var(--fail-ink); }

  /* Code is the one place mono belongs, and it keeps the ink ground it has
     everywhere else on the site. */
  .prose :global(code) {
    font-family: var(--mono); font-size: .8em; background: var(--paper-3);
    padding: 2px 5px; border-radius: var(--r-sm);
  }
  .prose :global(pre) {
    font-family: var(--mono); font-size: var(--t-label); line-height: 1.75;
    background: var(--void); color: var(--bone);
    padding: 22px 24px; overflow-x: auto; margin: 1.7em 0; border-radius: var(--r);
  }
  .prose :global(pre code) { background: none; padding: 0; font-size: inherit; }

  .end {
    margin-top: clamp(56px, 7vw, 90px); padding-top: 26px; border-top: 1px solid var(--rule);
    display: flex; flex-wrap: wrap; gap: 14px 30px; justify-content: space-between;
    color: var(--mid); font-size: var(--t-small);
  }
  .end p { color: inherit; }

  @media (max-width: 900px) {
    .col { max-width: none; }
  }
</style>
