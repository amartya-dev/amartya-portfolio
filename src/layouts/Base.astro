---
import '../styles/global.css';
const {
  title = 'Amartya Gaur · AI systems engineer',
  description = 'Amartya Gaur builds the layer agents run on: orchestration that survives a failed tool call, evals that can fail a deploy, and the infrastructure under both. Founder of hunr.ai; five years in Newfold Digital’s AI Center of Excellence.',
  theme = 'light',
  // Each post has a card drawn from its own figure, by scripts/og.mjs. Anything
  // without one falls back to the site card rather than to nothing, because a
  // shared link with no image is the version most people will see.
  og = 'default'
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(`/og/${og}.png`, Astro.site);
const path = Astro.url.pathname;
const NAV = [
  { href: '/#index', label: 'Work', on: (p) => p === '/' || p.startsWith('/work') },
  { href: '/blog', label: 'Writing', on: (p) => p.startsWith('/blog') },
  { href: '/ask', label: 'Ask', on: (p) => p.startsWith('/ask') },
  { href: '/about', label: 'About', on: (p) => p.startsWith('/about') },
  { href: '/#contact', label: 'Contact', on: () => false }
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Amartya Gaur" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={title} />
<meta name="theme-color" content="#FBF9F5" />
<meta name="color-scheme" content="light" />
<link rel="alternate" type="application/rss+xml" title="Amartya Gaur" href="/rss.xml" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23FBF9F5'/%3E%3Crect x='5' y='6' width='22' height='2' fill='%2316130F'/%3E%3Crect x='5' y='12' width='22' height='2' fill='%2316130F'/%3E%3Crect x='5' y='18' width='22' height='2' fill='%2316130F'/%3E%3Crect x='5' y='24' width='13' height='2' fill='%238A2B20'/%3E%3C/svg%3E" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- Newsreader says things, Instrument Sans labels them, Plex Mono holds data.
     Three faces, three jobs, and no face doing a job another one already has. -->
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class={theme === 'chamber' ? '' : 'light'}>
<a class="skip" href="#main">Skip to content</a>

<header class="top" id="top-bar" data-over={theme === 'chamber' ? 'dark' : 'light'}>
  <div class="wrap top-in">
    <a class="brand" href="/"><span class="full">Amartya Gaur</span><span class="short" aria-hidden="true">AG</span></a>
    <nav class="nav" aria-label="Sections">
      {NAV.map((n) => (
        <a href={n.href} aria-current={n.on(path) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
  </div>
</header>

<main id="main"><slot /></main>

<footer class="foot chamber">
  <div class="wrap foot-in">
    <span>Amartya Gaur · Bengaluru, UTC+5:30</span>
    <span><a href="/plain">plain version</a> · <a href="https://hunr.ai" rel="noopener">hunr.ai</a> · <a href="https://github.com/amartya-dev" rel="me noopener">github</a> · <a href="https://linkedin.com/in/amartya-gaur" rel="me noopener">linkedin</a> · <a href="/rss.xml">rss</a></span>
  </div>
</footer>

<script>
  document.documentElement.classList.add('js');

  // The running head knows whether paper or ink is under it, hides going down,
  // and returns coming up. A 6px deadzone so a trackpad twitch does not flap it.
  const bar = document.getElementById('top-bar');
  if (bar) {
    let lastY = window.scrollY;
    let ticking = false;
    const fallback = bar.dataset.over || 'light';
    const sections = [...document.querySelectorAll('main > section, main > article')];

    const themeAt = (y) => {
      for (const s of sections) {
        const top = s.offsetTop;
        if (y >= top - 66 && y < top + s.offsetHeight - 66) {
          return s.classList.contains('chamber') ? 'dark' : 'light';
        }
      }
      return fallback;
    };

    const update = () => {
      const y = window.scrollY;
      bar.dataset.over = themeAt(y);
      if (y > 8) bar.setAttribute('data-stuck', ''); else bar.removeAttribute('data-stuck');
      if (y > 240 && y > lastY + 6) bar.setAttribute('data-hidden', '');
      else if (y < lastY - 6 || y < 240) bar.removeAttribute('data-hidden');
      lastY = y;
      ticking = false;
    };

    update();
    addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    addEventListener('resize', update, { passive: true });
  }

  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('in');
      io.unobserve(e.target);
    });
  }, { rootMargin: '0px 0px -6% 0px', threshold: 0.1 });
  document.querySelectorAll('.rv').forEach((el, i) => {
    el.style.transitionDelay = (Math.min(i % 4, 3) * 60) + 'ms';
    io.observe(el);
  });
</script>
</body>
</html>
