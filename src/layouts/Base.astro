---
import '../styles/global.css';
const {
  title = 'Amartya Gaur · AI systems engineer',
  description = 'Amartya Gaur builds the layer agents run on: orchestration that survives a failed tool call, evals that can fail a deploy, and the infrastructure under both. Founder of hunr.ai; five years in Newfold Digital\u2019s AI Center of Excellence.',
  theme = 'chamber',
  // Each post has a card drawn from its own figure, by scripts/og.mjs. Anything
  // without one falls back to the site card rather than to nothing, because a
  // shared link with no image is the version most people will see.
  og = 'default'
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(`/og/${og}.png`, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Amartya Gaur" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={title} />
<meta name="color-scheme" content="dark light" />
<link rel="alternate" type="application/rss+xml" title="Amartya Gaur" href="/rss.xml" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%2308080A'/%3E%3Crect x='6' y='6' width='8' height='8' fill='%2335E08A'/%3E%3Crect x='18' y='6' width='8' height='8' fill='%2335E08A'/%3E%3Crect x='6' y='18' width='8' height='8' fill='%2335E08A'/%3E%3Crect x='18' y='18' width='8' height='8' fill='%23FF6244'/%3E%3C/svg%3E" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&display=swap" rel="stylesheet" />
</head>
<body class={theme === 'light' ? 'light' : ''}>
<a class="skip" href="#main">Skip to content</a>

<header class="top" id="top-bar" data-over="dark">
  <div class="wrap top-in mono">
    <a class="brand" href="/"><span class="full">Amartya Gaur</span><span class="short" aria-hidden="true">AG</span></a>
    <nav class="nav" aria-label="Sections">
      <a href="/#ask">Ask</a>
      <a href="/#work">Work</a>
      <a href="/blog">Writing</a>
      <a href="/about">About</a>
      <a href="/#contact">Contact</a>
    </nav>
  </div>
</header>

<main id="main"><slot /></main>

<footer class="foot chamber">
  <div class="wrap foot-in mono">
    <span>Amartya Gaur · Bengaluru, UTC+5:30</span>
    <span><a href="/plain">plain version</a> · <a href="https://hunr.ai" rel="noopener">hunr.ai</a> · <a href="https://github.com/amartya-dev" rel="me noopener">github</a> · <a href="https://linkedin.com/in/amartya-gaur" rel="me noopener">linkedin</a> · <a href="/rss.xml">rss</a></span>
  </div>
</footer>

<script>
  document.documentElement.classList.add('js');

  // Nav: knows whether it is over a light or dark section, hides going down,
  // returns coming up. A 6px deadzone so a trackpad twitch does not flap it.
  const bar = document.getElementById('top-bar');
  if (bar) {
    let lastY = window.scrollY;
    let ticking = false;
    const sections = [...document.querySelectorAll('main > section, main > article')];

    const themeAt = (y) => {
      for (const s of sections) {
        const top = s.offsetTop;
        if (y >= top - 63 && y < top + s.offsetHeight - 63) {
          return s.classList.contains('light') ? 'light' : 'dark';
        }
      }
      return 'dark';
    };

    const update = () => {
      const y = window.scrollY;
      bar.dataset.over = themeAt(y);
      if (y > 8) bar.setAttribute('data-stuck', ''); else bar.removeAttribute('data-stuck');
      if (y > 220 && y > lastY + 6) bar.setAttribute('data-hidden', '');
      else if (y < lastY - 6 || y < 220) bar.removeAttribute('data-hidden');
      lastY = y;
      ticking = false;
    };

    update();
    addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    addEventListener('resize', update, { passive: true });
  }
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('in');
      io.unobserve(e.target);
    });
  }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
  document.querySelectorAll('.rv').forEach((el, i) => {
    el.style.transitionDelay = (Math.min(i % 4, 3) * 70) + 'ms';
    io.observe(el);
  });
</script>
</body>
</html>
