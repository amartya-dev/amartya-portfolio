---
// "I build the layer AI agents run on" — drawn instead of argued.
//
// That sentence used to be followed by two dense paragraphs naming an
// orchestrator, a conversation rate, an eval count and a deploy gate: four
// facts and three clauses before a reader knew what any of it was for. A stack
// is the shape of the claim, so a stack is what carries it.
//
// Drawn as slabs rather than table rows, because the point is physical — these
// things sit underneath each other. Each slab has a hairline under it for
// thickness, they are separated by real gaps, and a bracket runs down the left
// of the three that are mine. The top slab is dashed and unlinked because it is
// not mine and there is nothing of mine to go and look at.
//
// The glyphs are the argument in miniature: a call fanning out to one of several
// handlers, a gate that lets one thing through and stops another, and a stack of
// boxes. Anyone who reads only the pictures still gets the claim.
const TIERS = [
  {
    n: 'Orchestration',
    d: 'Routing and state that survive a failed tool call.',
    v: '≈1,000 conversations an hour',
    href: '/work/agent-orchestration/',
    g: 'route'
  },
  {
    n: 'Evaluation',
    d: 'Regression cases in the pipeline, so a prompt edit can fail a build.',
    v: '739 cases, blocking',
    href: '/work/eval-gate/',
    g: 'gate'
  },
  {
    n: 'Infrastructure',
    d: 'Sandboxes, images and clusters for code nobody has read yet.',
    v: 'microVMs, no egress',
    href: '/work/hunr/',
    g: 'slab'
  }
];
---
<figure class="stack rv">
  <!-- Not mine. Dashed, dimmed, sitting slightly apart from the three below it. -->
  <div class="ghost">
    <span class="gl" aria-hidden="true">
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25"
        stroke-linecap="round" stroke-linejoin="round">
        <circle cx="16" cy="12" r="6" stroke-dasharray="3 2.5" />
        <path d="M8 27c1.6-4.2 4.4-6.3 8-6.3s6.4 2.1 8 6.3" stroke-dasharray="3 2.5" />
      </svg>
    </span>
    <span class="txt">
      <span class="tn mono">Agents</span>
      <span class="td">Whatever you are building on top.</span>
    </span>
  </div>

  <div class="mine">
    <div class="brace" aria-hidden="true"><span>what I build</span></div>

    <ol class="tiers">
      {TIERS.map((t) => (
        <li class="tier">
          <a href={t.href}>
            <span class="gl" aria-hidden="true">
              {t.g === 'route' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 16h8" />
                  <path d="M10 16c6 0 5.5-10 11.5-10" />
                  <path d="M10 16h11.5" />
                  <path d="M10 16c6 0 5.5 10 11.5 10" />
                  <circle cx="24" cy="6" r="2.3" />
                  <circle cx="24" cy="16" r="2.3" />
                  <circle cx="24" cy="26" r="2.3" />
                </svg>
              )}
              {t.g === 'gate' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 3v26" />
                  <path d="M3 10h9" />
                  <path d="M19.5 10.5l2.8 2.8 5.7-6.4" />
                  <path d="M3 22h5" />
                  <path d="M10 19l6 6M16 19l-6 6" />
                </svg>
              )}
              {t.g === 'slab' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.25"
                  stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="20.5" width="26" height="7.5" rx="1.5" />
                  <rect x="3" y="11.5" width="26" height="6.5" rx="1.5" />
                  <rect x="8.5" y="3" width="15" height="6" rx="1.5" />
                  <path d="M12 6h8" />
                </svg>
              )}
            </span>
            <span class="txt">
              <span class="tn mono">{t.n}</span>
              <span class="td">{t.d}</span>
            </span>
            <span class="tv mono">{t.v}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</figure>

<style>
  .stack { margin: 0; display: grid; gap: 10px; }

  /* Shared slab. The hairline underneath is the thickness — it is what stops
     four boxes in a column reading as four rows of a table. */
  .ghost, .tier {
    border: 1px solid var(--rule); border-radius: var(--r);
    background: var(--paper-2); box-shadow: 0 2px 0 var(--rule-2);
  }
  .ghost {
    display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); gap: 18px;
    align-items: center; padding: 15px 20px;
    border-style: dashed; border-color: color-mix(in oklab, var(--mid) 50%, transparent);
    background: none; box-shadow: none;
    margin-left: 2.75rem;
  }
  .ghost .tn, .ghost .td, .ghost .gl { color: var(--mid); }

  .mine { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); }

  /* An actual bracket: three borders and no fourth, which is the shape a printed
     diagram uses to say "these, together, are one thing". */
  .brace {
    grid-column: 1; margin: 2px 12px 4px 0;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--rule); border-right: 0;
    border-radius: var(--r) 0 0 var(--r);
  }
  .brace span {
    writing-mode: vertical-rl; transform: rotate(180deg);
    font-family: var(--mono); font-size: var(--t-micro);
    letter-spacing: .12em; text-transform: uppercase; color: var(--fail-ink);
    white-space: nowrap;
  }

  .tiers { grid-column: 2; display: grid; gap: 10px; }

  .tier a {
    display: grid; grid-template-columns: 2.75rem minmax(0, 1fr) auto;
    gap: 18px; align-items: center; padding: 15px 20px;
    text-decoration: none; border-radius: var(--r);
    transition: background-color .16s ease;
  }
  .tier { transition: border-color .16s ease, transform .16s ease; }
  .tier:hover { border-color: var(--fail-ink); transform: translateY(-1px); }
  .tier a:hover { color: inherit; }

  .gl { display: block; color: var(--ink-2); }
  .gl svg { width: 100%; height: auto; display: block; }
  .tier:hover .gl { color: var(--fail-ink); }

  .txt { display: grid; gap: 4px; min-width: 0; }
  .tn {
    font-size: var(--t-label); letter-spacing: .1em; text-transform: uppercase;
    color: var(--ink); font-weight: 500;
  }
  .td { color: var(--ink-2); font-size: var(--t-body); line-height: 1.45; }
  .tv {
    font-size: var(--t-micro); color: var(--mid); letter-spacing: .03em;
    white-space: nowrap; justify-self: end;
  }

  /* Under about 860px the evidence cannot share a line with the sentence without
     shredding both, so it drops under the text and the bracket narrows. */
  @media (max-width: 860px) {
    .tier a { grid-template-columns: 2.25rem minmax(0, 1fr); row-gap: 10px; gap: 14px; }
    .tv { grid-column: 2; justify-self: start; }
    .ghost { grid-template-columns: 2.25rem minmax(0, 1fr); gap: 14px; margin-left: 2rem; }
    .mine { grid-template-columns: 2rem minmax(0, 1fr); }
    .brace { margin-right: 8px; }
  }
</style>
