---
import Flow from './Flow.astro';
import Social from './Social.astro';
import AskBar from './AskBar.astro';

// A title page: a name, the claim, five ways out, and a picture of the claim.
//
// It has lost two things it used to carry. The colophon line — "AI SYSTEMS
// ENGINEER · BENGALURU · UTC+5:30" — said in small caps what the sentence
// underneath it says in full, and the city is in the footer of every page
// anyway. And two paragraphs of prose about Newfold, 230,000 model calls and
// seven negative registrations, every one of which has a page of its own further
// down or on /work. A title page that has already started arguing is not a title
// page.
//
// What replaced the prose is the drawing, because the claim is a claim about
// shape and a shape should be drawn. Type left, picture right, meeting on a
// shared centre line: the name is still the loudest thing on the site, but it is
// no longer the only thing on the first screen.
---
<section class="masthead chamber">
  <div class="wrap">
    <div class="body rv">
      <div class="title">
        <h1 class="d d-1">Amartya&nbsp;Gaur</h1>
        <p class="sub">I build the layer AI agents run on.</p>

        <p class="role">Founder and engineer at <a href="https://hunr.ai" rel="noopener">hunr.ai</a></p>

        <AskBar />
        <Social />
      </div>

      <Flow />
    </div>
  </div>

  <!-- The band closes on a graduated scale rather than a rule: the six years
       are the first measurement in the document, and a scale is a cheaper way
       to say "since 2020" than a sentence saying it. The five overlapping spans
       it used to introduce now live on /work with the rest of the record. -->
  <div class="scale wrap" aria-hidden="true">
    <div class="tickrule"></div>
    <p class="years mono"><span>2020</span><span>2021</span><span>2022</span><span>2023</span
      ><span>2024</span><span>2025</span><span>2026</span></p>
  </div>
</section>

<style>
  /* The colophon line used to hold the name down off the running head. With it
     gone the padding has to do that job on its own. */
  .masthead { padding-top: clamp(116px, 13vw, 172px); }

  .body {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 400px);
    gap: clamp(30px, 5vw, 64px); align-items: center;
  }
  .title { min-width: 0; }

  /* A step down from the global display size: at 6.5rem the name on its own is
     wider than the column it now shares with the drawing. It is still, by a wide
     margin, the loudest thing on the site. */
  h1 { color: var(--bone); font-size: clamp(3rem, 6vw, 5.4rem); }

  /* The subtitle of a title page, in italic serif. It is the claim; everything
     under it is the evidence for the claim. */
  .sub {
    margin-top: clamp(18px, 2.4vw, 30px);
    font-family: var(--display); font-optical-sizing: auto;
    font-style: italic; font-weight: 380;
    font-size: clamp(1.4rem, 2.9vw, 2.35rem); line-height: 1.24; letter-spacing: -.014em;
    color: var(--bone-2); max-width: 22ch;
  }

  /* The one line of standing fact left on the title page. It sits directly
     under the claim because "founder of what" is the first question the claim
     provokes, and the answer is a link. */
  .role {
    margin-top: clamp(16px, 2vw, 22px);
    font-size: var(--t-small); color: var(--bone-dim); letter-spacing: .01em;
  }
  .role a { color: var(--bone-2); }
  .role a:hover { color: var(--fail-lit); }

  .scale { padding-top: clamp(56px, 7vw, 96px); padding-bottom: 30px; }
  /* The rule runs past the last label, because 2026 is not the end of the scale. */
  .scale .tickrule { width: auto; margin-right: calc(50% - 50vw); }
  .years {
    display: flex; justify-content: space-between; margin-top: 8px;
    color: var(--bone-3); font-size: var(--t-micro); letter-spacing: .04em;
  }

  /* Below this the name and the drawing cannot share a line without one of them
     being squeezed, so the drawing drops under the social row. */
  @media (max-width: 1000px) {
    .body { grid-template-columns: minmax(0, 1fr); align-items: start; }
  }

  @media (max-width: 640px) {
    .sub { max-width: none; }
    .years span:nth-child(even) { visibility: hidden; }
  }
</style>
