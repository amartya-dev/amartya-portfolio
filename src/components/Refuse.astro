---
import Head from './Head.astro';
const PLATFORMS = [
  { n: 'TikTok',         views: 1240000, reach: 402000, rule: 'the video starts' },
  { n: 'Instagram',      views: 412000,  reach: 180000, rule: 'a play, any length' },
  { n: 'YouTube Shorts', views: 305000,  reach: 150000, rule: 'a play, any length' },
  { n: 'YouTube',        views: 96400,   reach: 61000,  rule: 'about 30 seconds watched' },
  { n: 'Pinterest',      views: 71900,   reach: 39000,  rule: 'the pin enters the viewport' },
  { n: 'LinkedIn',       views: 58200,   reach: 44000,  rule: 'three seconds on screen' }
];
const total = PLATFORMS.reduce((s, p) => s + p.views, 0);
const maxReach = Math.max(...PLATFORMS.map((p) => p.reach));
---
<section id="refuse" class="light sec">
  <div class="wrap">
    <Head title="A number is not a fact" fig="Fig. 07">Six platforms, six different
      definitions of a &ldquo;view&rdquo;. Ask this one the obvious question and it argues with you instead of
      answering.</Head>
    <div class="figured chat rv" data-chat>
      <div class="log" data-log>
        <p class="msg bot mono">Ask me about last month. I know three questions, because this is a portfolio and not
          the real thing.</p>
      </div>

      <div class="asks mono">
        <button type="button" class="q" data-q="total">How many views did I get in total?</button>
        <button type="button" class="q" data-q="reach">How did reach compare by platform?</button>
        <button type="button" class="q" data-q="drift">Is Instagram up since April?</button>
      </div>
    </div>

    <p class="src mono rv">Real counting rules, real drift dates, simulated numbers. The platforms don&rsquo;t hand out
      API access to people building demos. Built for a private assessment, so this is the idea rather than the code.</p>
  </div>
</section>

<script define:vars={{ PLATFORMS, total, maxReach }}>
  const root = document.querySelector('[data-chat]');
  if (root) {
    const log = root.querySelector('[data-log]');
    const money = (n) => n.toLocaleString('en-US');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const asked = new Set();

    const push = (html, cls, delay) =>
      new Promise((res) => {
        setTimeout(() => {
          const el = document.createElement('div');
          el.className = 'msg ' + cls;
          el.innerHTML = html;
          log.appendChild(el);
          requestAnimationFrame(() => el.classList.add('in'));
          log.scrollTop = log.scrollHeight;
          res();
        }, reduced ? 0 : delay);
      });

    const bars = (key) =>
      '<div class="bars">' +
      PLATFORMS.map(
        (p) =>
          `<div class="bar-row"><span class="bar-n">${p.n}</span>` +
          `<span class="bar-t"><i style="--w:${(p[key] / maxReach) * 100}%"></i></span>` +
          `<span class="bar-v">${money(p[key])}</span></div>`
      ).join('') +
      '</div>';

    const ANSWERS = {
      total: async () => {
        await push('How many views did I get in total?', 'you', 120);
        await push(
          `<b>No.</b> I can add them, and it comes to ${money(total)}, and the number would be fiction. ` +
            'A TikTok view is the video starting. A YouTube view is about thirty seconds of it. ' +
            'Summing those averages a second into a minute and hands you a decision you can’t defend.',
          'bot refuse',
          420
        );
        await push(
          '<span class="hint">Every platform&rsquo;s rule, since you asked:</span><div class="rules">' +
            PLATFORMS.map((p) => `<span><b>${p.n}</b> ${p.rule}</span>`).join('') +
            '</div>',
          'bot',
          520
        );
        await push(
          'Ask me for <b>reach</b> instead. It is the one thing all six count the same way.',
          'bot nudge',
          420
        );
      },
      reach: async () => {
        await push('How did reach compare by platform?', 'you', 120);
        await push('That one I&rsquo;ll answer. Same definition everywhere, so the comparison holds.', 'bot', 380);
        await push(bars('reach'), 'bot chartmsg', 420);
      },
      drift: async () => {
        await push('Is Instagram up since April?', 'you', 120);
        await push(
          '<b>Up 34%, and I&rsquo;d hold that number lightly.</b> Instagram changed what counts as a view on ' +
            '<b>21 April 2025</b>. The step in the data is the definition moving, not your audience.',
          'bot refuse',
          420
        );
        await push(
          '<span class="hint">Comparisons across that date are served versioned, with the boundary marked. ' +
            'The detector found the step on its own; a human approved the new version.</span>',
          'bot',
          480
        );
      }
    };

    root.querySelectorAll('.q').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (btn.disabled) return;
        root.querySelectorAll('.q').forEach((b) => (b.disabled = true));
        await ANSWERS[btn.dataset.q]();
        asked.add(btn.dataset.q);
        btn.classList.add('done');
        root.querySelectorAll('.q').forEach((b) => (b.disabled = false));
        if (asked.size === 3) {
          await push('That is everything I know. The real one writes TypeScript against the data layer and runs it.', 'bot', 500);
        }
      });
    });
  }
</script>

<style>
  .chat { margin-top: clamp(34px, 4vw, 54px); border: 1px solid var(--rule); background: var(--paper-2); border-radius: var(--r); }
  .log { padding: 22px 20px; display: grid; gap: 12px; max-height: 520px; overflow-y: auto; }
  .log :global(.msg) { opacity: 0; transform: translateY(8px); transition: opacity .35s ease, transform .35s ease; }
  .log :global(.msg.in) { opacity: 1; transform: none; }
  .log :global(.you) {
    justify-self: end; max-width: 34ch; background: var(--ink); color: var(--paper);
    padding: 11px 16px; font-family: var(--mono); font-size: .76rem; letter-spacing: .03em;
  }
  .log :global(.bot) { max-width: 62ch; font-size: 1rem; color: var(--ink-2); line-height: 1.55; }
  .log :global(.bot.mono) { font-family: var(--mono); font-size: .76rem; color: var(--mid); letter-spacing: .03em; }
  .log :global(.refuse) { border-left: 3px solid var(--fail); padding-left: 16px; }
  .log :global(.nudge) { border-left: 3px solid var(--pass); padding-left: 16px; }
  .log :global(.msg b) { color: var(--ink); font-weight: 600; }
  .log :global(.hint) { color: var(--mid); font-size: .92rem; }
  .log :global(.rules) { display: grid; gap: 5px; margin-top: 12px; font-family: var(--mono); font-size: .7rem; letter-spacing: .03em; color: var(--mid); }
  .log :global(.rules b) { display: inline-block; min-width: 130px; font-weight: 500; color: var(--ink-2); }
  .log :global(.bars) { display: grid; gap: 7px; margin-top: 6px; }
  .log :global(.bar-row) { display: grid; grid-template-columns: 130px 1fr 74px; gap: 12px; align-items: center; font-family: var(--mono); font-size: .7rem; letter-spacing: .03em; }
  .log :global(.bar-t) { height: 11px; background: var(--paper-2); display: block; }
  .log :global(.bar-t i) { display: block; height: 100%; width: var(--w); background: var(--ink); animation: grow .7s cubic-bezier(.2,.8,.2,1); transform-origin: left; }
  .log :global(.bar-v) { text-align: right; color: var(--mid); }
  @keyframes grow { from { transform: scaleX(0); } }

  .asks { display: flex; flex-wrap: wrap; gap: 8px; padding: 16px 20px; border-top: 1px solid var(--rule); background: var(--paper-2); }
  .q {
    font: inherit; font-family: var(--mono); font-size: .72rem; letter-spacing: .04em; cursor: pointer;
    background: var(--paper); border: 1px solid var(--rule); color: var(--ink-2); padding: 9px 14px;
    transition: all .18s ease;
  }
  .q:hover:not(:disabled) { border-color: var(--ink); }
  .q:disabled { opacity: .45; cursor: default; }
  .q.done { color: var(--mid); border-style: dashed; }
  .src { margin-top: 18px; color: var(--mid); text-transform: none; letter-spacing: .03em; max-width: 62ch; line-height: 1.7; }

  @media (max-width: 620px) {
    .log :global(.bar-row) { grid-template-columns: 96px 1fr 62px; gap: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .log :global(.bar-t i) { animation: none; }
  }
</style>
