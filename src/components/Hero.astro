<section class="hero chamber">
  <canvas id="swarm" aria-hidden="true"></canvas>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="wrap hero-in">
    <p class="mono eyebrow">Agent orchestration · Evals · Infrastructure</p>
    <h1 class="d d-1">Amartya<br />Gaur</h1>
    <p class="hero-sub">
      I build the layer agents run on — orchestration that survives a failed tool call, evaluation that can stop a deploy, and the infrastructure under both. Currently building <a href="https://hunr.ai" rel="noopener">hunr.ai</a>.
    </p>
  </div>

  <div class="readout mono" id="readout" aria-hidden="true">
    <span>eval run <b data-run>000</b></span>
    <span class="ok">passing <b data-pass>0</b></span>
    <span class="no">failing <b data-fail>0</b></span>
    <span class="dimmed">739 cases</span>
  </div>
  <button type="button" class="view mono" data-view aria-pressed="false">
    <span data-view-label>Order</span>
  </button>
  <a class="cue mono" href="#what">Scroll<span aria-hidden="true"></span></a>
</section>

<script>
  import { mountSwarm } from '../scripts/swarm.js';
  const canvas = document.getElementById('swarm');
  if (canvas) {
    const swarm = mountSwarm(canvas, document.getElementById('readout'));
    const btn = document.querySelector('[data-view]');
    const label = document.querySelector('[data-view-label]');
    const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    let ordered = false, timer = null;

    // Scramble the control, never the content — it is feedback that the state moved.
    function morph(to) {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { label.textContent = to; return; }
      clearInterval(timer);
      const from = label.textContent;
      const len = Math.max(from.length, to.length);
      let f = 0;
      timer = setInterval(() => {
        label.textContent = Array.from({ length: len }, (_, i) => {
          if (i < f / 2.2) return to[i] || '';
          return CHARS[(Math.random() * 26) | 0];
        }).join('');
        if (f++ > len * 2.2 + 2) { clearInterval(timer); label.textContent = to; }
      }, 40);
    }

    btn.addEventListener('click', () => {
      ordered = !ordered;
      swarm.setOrder(ordered);
      btn.setAttribute('aria-pressed', String(ordered));
      btn.setAttribute('aria-label', ordered ? 'Show the suite as an object' : 'Show the suite as a matrix');
      morph(ordered ? 'Flow' : 'Order');
    });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  #swarm { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .hero-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(100deg, #08080a 10%, rgba(8,8,10,.92) 38%, rgba(8,8,10,.15) 68%);
  }
  .hero-in { position: relative; padding-block: 120px 40px; }
  .hero-in :global(.d-1) { margin-bottom: clamp(24px, 3vw, 38px); }
  .hero-sub {
    max-width: 34ch; font-size: clamp(1.05rem, 1.55vw, 1.35rem); line-height: 1.5;
    color: #c9c9cf;
  }
  .hero-sub a { color: var(--pass-lit); text-decoration-thickness: 1px; text-underline-offset: 4px; }

  .readout {
    position: absolute; left: var(--gut); bottom: 30px; z-index: 2;
    display: flex; flex-wrap: wrap; gap: 8px 24px; color: var(--bone-dim);
  }
  .readout b { font-weight: 500; font-variant-numeric: tabular-nums; }
  .readout .ok b { color: var(--pass-lit); }
  .readout .no b { color: var(--fail-lit); }

  .view {
    position: absolute; right: var(--gut); top: 96px; z-index: 3;
    font: inherit; font-family: var(--mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase;
    background: none; border: 1px solid #2b2b35; color: var(--bone-dim);
    padding: 9px 16px; cursor: pointer; min-width: 92px; transition: border-color .2s ease, color .2s ease;
  }
  .view:hover { border-color: var(--bone-dim); color: var(--bone); }
  .view[aria-pressed='true'] { border-color: var(--pass-lit); color: var(--pass-lit); }

  .cue {
    position: absolute; right: var(--gut); bottom: 30px; z-index: 2;
    color: var(--bone-dim); text-decoration: none; display: flex; align-items: center; gap: 10px;
  }
  .cue span { width: 34px; height: 1px; background: currentColor; display: block; }
  .cue:hover { color: var(--bone); }

  @media (max-width: 860px) {
    .hero-scrim { background: linear-gradient(180deg, rgba(8,8,10,.92) 0%, rgba(8,8,10,.62) 24%, rgba(8,8,10,.9) 52%, rgba(8,8,10,.97) 100%); }
    .hero-in { padding-block: 128px 92px; }
    .cue { display: none; }
    .view { top: auto; bottom: 76px; right: var(--gut); }
  }
</style>
