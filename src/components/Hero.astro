---
const FACTS = [
  { k: 'Now', v: 'Founder of hunr.ai' },
  { k: 'Before', v: 'Five years at Newfold Digital' },
  { k: 'Where', v: 'Bengaluru, remote' }
];
---
<section class="hero chamber">
  <div class="wrap hero-in">
    <p class="mono eyebrow rv">Amartya Gaur — AI systems engineer</p>

    <h1 class="d rv">
      I build the<br />machinery behind<br /><em>AI assistants</em>
    </h1>

    <p class="sub rv">The part that decides what they should do, checks they actually did it, and keeps the
      whole thing standing up when one of them fails at three in the morning.</p>

    <dl class="facts mono rv">
      {FACTS.map((f) => (
        <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
      ))}
    </dl>

    <ul class="quick mono rv">
      <li><a href="https://github.com/amartya-dev" rel="me noopener">GitHub</a></li>
      <li><a href="https://linkedin.com/in/amartya-gaur" rel="me noopener">LinkedIn</a></li>
      <li><a href="https://hunr.ai" rel="noopener">hunr.ai</a></li>
      <li><a href="/blog">Writing</a></li>
      <li><a href="/about">About me</a></li>
      <li><a href="mailto:amartya@hunr.ai">Email</a></li>
    </ul>

    <p class="try mono rv">
      <a href="#router">Three of these are on this page, working</a>
      <span aria-hidden="true">↓</span>
    </p>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh; display: flex; align-items: center;
    border-bottom: 1px solid var(--rule-dark);
  }
  .hero-in { padding-block: 140px 80px; width: 100%; }
  .eyebrow { color: var(--bone-dim); margin-bottom: clamp(28px, 4vw, 44px); }

  h1 {
    font-size: clamp(2.6rem, 7.6vw, 6.6rem);
    margin-bottom: clamp(28px, 3.5vw, 44px);
  }
  h1 em { font-style: normal; color: var(--pass-lit); }

  .sub {
    max-width: 40ch; font-size: clamp(1.1rem, 1.6vw, 1.42rem); line-height: 1.5;
    color: #c4c4cc;
  }

  .facts {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 20px 40px; margin-top: clamp(48px, 6vw, 82px);
    border-top: 1px solid var(--rule-dark); padding-top: 24px;
  }
  .facts dt { color: #55555f; text-transform: uppercase; letter-spacing: .14em; font-size: .6rem; margin-bottom: 8px; }
  .facts dd { margin: 0; color: var(--bone); font-size: .82rem; letter-spacing: .02em; }

  .quick { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .quick a {
    display: block; color: var(--bone-dim); text-decoration: none;
    border: 1px solid #2a2a34; padding: 8px 14px; transition: all .18s ease;
  }
  .quick a:hover { color: var(--void); background: var(--pass-lit); border-color: var(--pass-lit); }

  .try { margin-top: clamp(26px, 3vw, 38px); display: flex; align-items: center; gap: 12px; color: var(--bone-dim); }
  .try a { color: inherit; text-decoration: none; border-bottom: 1px solid #33333d; padding-bottom: 4px; }
  .try a:hover { color: var(--bone); border-color: var(--bone); }

  @media (max-width: 660px) {
    .hero-in { padding-block: 120px 64px; }
  }
</style>
