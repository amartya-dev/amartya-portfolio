---
// A drawing sheet, not a landing page.
//
// The generated shape is a centred display headline, a subhead, and a row of
// icons. This is the opposite arrangement: the subject runs off the right edge
// of the sheet at the size it deserves, the text sits under the name in a single
// narrow column, and the band closes on a graduated scale rather than a rule.
//
// The name is set large because this is a personal site and the name is the
// subject. Everything under it is a specific claim with a link to its evidence,
// which is the part a generated page cannot supply.
import Film from './Film.astro';
import Plate from './Plate.astro';

const LINKS = [
  { href: 'https://github.com/amartya-dev', label: 'github', rel: 'me noopener', fill: true,
    d: 'M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.13-.3-.54-1.53.11-3.18 0 0 1.01-.32 3.3 1.23a11.4 11.4 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.23 0 4.63-2.8 5.65-5.48 5.95.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 22.29 24 17.79 24 12.5 24 5.87 18.63.5 12 .5z' },
  { href: 'https://linkedin.com/in/amartya-gaur', label: 'linkedin', rel: 'me noopener', fill: true,
    d: 'M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zm1.78 13.02H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z' },
  { href: 'mailto:amartya@hunr.ai', label: 'amartya@hunr.ai', rel: '', fill: false,
    d: 'M2.6 5.6h18.8v12.8H2.6zM3.4 6.6l8.6 6 8.6-6' }
];
---
<section class="hero chamber">
  <div class="graticule" aria-hidden="true"></div>

  <div class="wrap hero-in">
    <div class="say rv">
      <h1 class="d">Amartya Gaur</h1>

      <p>I build the layer AI agents run on. Five years of that was inside Newfold Digital&rsquo;s AI
        Center of Excellence: a <a href="/blog/a-sticky-orchestrator/">sticky orchestrator</a> carrying
        about a thousand support conversations an hour, and <a href="/blog/739-cases/">739 regression
        cases</a> wired into the deploy pipeline so a prompt edit can fail a build. Since August 2026
        it has been <a href="https://hunr.ai" rel="noopener">hunr.ai</a>, which I write on my own.</p>

      <p class="quiet">I also spent about 230,000 model calls trying to disprove my own routing design.
        Seven of ten pre-registered experiments <a href="/blog/what-a-routing-benchmark-cannot-measure/">came
        back negative</a>. That half is on this page too, because it is the more useful half.</p>

      <p class="links">
        <span>Bengaluru</span>
        {LINKS.map((l) => (
          <a href={l.href} rel={l.rel || undefined}>
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
              fill={l.fill ? 'currentColor' : 'none'} stroke={l.fill ? 'none' : 'currentColor'}
              stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={l.d} /></svg><span>{l.label}</span>
          </a>
        ))}
      </p>
    </div>

    <div class="show rv">
      <Plate no="Fig. 01">
        <Film
          src="/media/hunr-a-thousand-resumes.mp4"
          poster="/media/hunr-a-thousand-resumes.jpg"
          length="1:05"
        />
      </Plate>
      <p class="under">A film for hunr, cut by <a href="/blog/a-pipeline-that-cannot-invent-your-ui/">a
        pipeline I built</a> that lifts every screen out of the product&rsquo;s own source, so it cannot
        invent a UI that does not exist.</p>
    </div>
  </div>

  <div class="scale wrap" aria-hidden="true">
    <div class="tickrule"></div>
    <p class="mono years"><span>2020</span><span>2021</span><span>2022</span><span>2023</span
      ><span>2024</span><span>2025</span><span>2026</span></p>
  </div>
</section>

<style>
  .hero { position: relative; border-bottom: 1px solid var(--rule-dark); overflow: hidden; }
  .hero > * { position: relative; z-index: 1; }
  .graticule {
    -webkit-mask-image: radial-gradient(85% 75% at 26% 52%, #000 8%, transparent 78%);
    mask-image: radial-gradient(85% 75% at 26% 52%, #000 8%, transparent 78%);
  }

  /* The film runs off the right edge of the sheet. A subject cropped by the
     page reads as larger than the page; a subject centred in a box reads as a
     thumbnail, which is what it was. */
  .hero-in {
    display: grid; grid-template-columns: minmax(0, 30rem) minmax(0, 1fr);
    gap: clamp(30px, 4vw, 64px); align-items: start;
    padding-block: clamp(112px, 13vw, 158px) clamp(40px, 5vw, 62px);
  }
  .show { margin-right: calc(50% - 50vw); }
  /* The plate runs off the sheet, so its number moves to the edge that is still
     on it. */
  .show :global(.plate-no) { right: auto; left: 0; }

  /* The one place on the site where type is allowed to be loud. It is a name,
     which is the only thing on the page that does not need qualifying. */
  h1 {
    font-size: clamp(2.6rem, 5.4vw, 4.6rem); line-height: .86;
    color: var(--bone); margin-bottom: var(--s-3);
  }

  .say p { font-size: var(--t-body); line-height: 1.62; color: var(--bone-2); }
  .say p + p { margin-top: .9em; }
  .quiet { color: var(--bone-dim) !important; }
  .say a { color: var(--bone); }
  .quiet a { color: var(--bone-2); }

  .links {
    display: flex; flex-wrap: wrap; align-items: center; gap: 9px 20px;
    margin-top: var(--s-4) !important; padding-top: var(--s-3); border-top: 1px solid var(--rule-dark);
    font-size: var(--t-small) !important; color: var(--bone-dim) !important;
  }
  .links a { display: inline-flex; align-items: center; gap: 7px; color: var(--bone-2) !important; }
  .links a svg { flex: none; opacity: .7; }
  .links a:hover svg { opacity: 1; }

  .under { margin-top: var(--s-2); color: var(--bone-dim); font-size: var(--t-small); line-height: 1.6; max-width: 54ch; }
  .under a { color: var(--bone-2); }

  /* The band ends on a graduated scale rather than a plain rule, because the six
     years underneath the page are the first measurement on it. */
  .scale { padding-bottom: 26px; }
  /* The rule runs off the right edge with the film, and past the last label,
     because 2026 is not the end of the scale. */
  .scale .tickrule { width: auto; margin-right: calc(50% - 50vw); }
  .years { display: flex; justify-content: space-between; margin-top: 7px; color: var(--bone-dim); font-size: var(--t-micro); letter-spacing: -.005em; }

  @media (max-width: 1000px) {
    .hero-in { grid-template-columns: 1fr; gap: var(--s-4); padding-block: 108px 46px; }
    .show { margin-right: calc(-1 * var(--gut)); }
    .say { max-width: 60ch; }
  }
</style>
