---
// The front page's way into /ask.
//
// /ask is the most unusual thing on this site and it was reachable only through
// a four-letter word in the running head, which is the same weight the nav gives
// "About". A link describing an input is weaker than the input: a field with a
// cursor in it asks to be typed in, and a reader who types a question has
// already decided to stay.
//
// This does not answer anything. It carries the sentence to /ask?q= and that
// page does the work, so there is exactly one asking implementation, one set of
// spending guards, and one place a question can be answered. Without JavaScript
// it is a GET form to the same address, which behaves identically.
const SUGGEST = [
  'What has he actually run in production?',
  'How does he test agents?'
];
---
<form class="askbar" action="/ask" method="get">
  <label class="sr" for="hero-ask">Ask this site a question about Amartya</label>
  <div class="field">
    <input id="hero-ask" name="q" type="text" autocomplete="off" maxlength="400"
      placeholder="Ask this site about my work" />
    <button type="submit" aria-label="Ask">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h13M12.5 6l6 6-6 6" />
      </svg>
    </button>
  </div>
</form>

<!-- Links, not submit buttons. As buttons they sat inside the form and carried
     the name "q", the same name the text input has, so clicking one submitted
     q= (empty, from the input) followed by q=the-question — and the reader of
     that query string takes the first. Every suggestion silently did nothing.
     A link carries exactly one question and needs no JavaScript either. -->
<p class="hint">
  {SUGGEST.map((s) => <a class="sg" href={`/ask?q=${encodeURIComponent(s)}`}>{s}</a>)}
</p>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .askbar { margin-top: clamp(30px, 3.6vw, 42px); max-width: 30rem; }

  .field {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center;
    border: 1px solid var(--rule-dark-2); border-radius: var(--r);
    background: var(--void-2);
    transition: border-color .18s ease, background-color .18s ease;
  }
  .field:focus-within { border-color: var(--bone-3); background: var(--void-3); }

  input {
    font: inherit; font-size: 1rem; color: var(--bone);
    background: none; border: 0; padding: 14px 4px 14px 16px; min-width: 0;
  }
  input::placeholder { color: var(--bone-3); }
  input:focus { outline: none; }

  button[type='submit'] {
    display: grid; place-items: center; cursor: pointer;
    background: none; border: 0; padding: 12px 14px;
    color: var(--bone-3); transition: color .16s ease, transform .2s ease;
  }
  .field button[type='submit']:hover { color: var(--fail-lit); transform: translateX(2px); }

  /* Two real questions rather than a sentence explaining that you may ask
     questions. */
  .hint {
    display: flex; flex-wrap: wrap; gap: 8px 18px;
    margin-top: 12px; max-width: 30rem;
  }
  .sg {
    font-size: var(--t-label); text-decoration: none;
    color: var(--bone-dim); border-bottom: 1px solid var(--rule-dark-2);
    padding-bottom: 1px; transition: color .16s ease, border-color .16s ease;
  }
  .sg:hover { color: var(--bone-2); border-bottom-color: var(--bone-3); }
</style>
