---
// The head of a band, inside the content column of a spread.
//
// It used to be a two-column row: heading left, grey sans lede right, figure
// number floating under the lede. Four of those in a row read as a template,
// and the lede — the sentence doing the actual arguing — was set in the same
// face and nearly the same size as the body underneath it, so it argued quietly.
//
// Now it stacks, and the lede is an italic serif standfirst, which is how a set
// page marks the difference between "this is the claim" and "this is the detail".
// The section number lives out in the rail, so nothing here has to carry it.
const { title, fig, id } = Astro.props;
---
<header class="bandhead rv">
  <h2 class="d d-sec" id={id}>{title}</h2>
  <p class="lede"><slot /></p>
  {fig && <p class="fig-no">{fig}</p>}
</header>

<style>
  .bandhead { margin-bottom: var(--s-4); max-width: 62ch; }
  .lede { margin-top: var(--s-2); }
  .fig-no { margin-top: var(--s-3); }
</style>
