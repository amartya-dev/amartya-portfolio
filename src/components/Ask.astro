---
import Head from './Head.astro';
// Ask the page. An agent with five tools, a catalogue of everything this site
// holds, and no other way to reach you: prose it cannot source is rejected and
// asked again in front of you, and chart numbers come from series this page counts
// rather than from the model. Same argument as the data layer further down, turned
// on me.
//
// The endpoint is functions/api/ask.js and it needs ANTHROPIC_API_KEY. Without it
// the box still answers from the index alone, and says that is what it is doing.
import { getCollection } from 'astro:content';
import { buildIndex, buildPlots } from '../data/ask.js';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const INDEX = buildIndex(posts);
const PLOTS = buildPlots(posts);

const OPENERS = [
  'How long has he been doing this?',
  'What has he actually shipped?',
  'How does he test an agent?',
  'What salary does he want?'
];
---
<section id="ask" class="chamber sec">
  <div class="wrap">
    <Head title="Ask it. It has to cite." fig="Fig. 02">It will not tell you anything this
      page cannot back up.</Head>
    <div class="figured box rv" data-ask>
      <div class="head">
        <span class="live" aria-hidden="true"></span>
        <span class="who">Amartya&rsquo;s site</span>
        <span class="idx">{INDEX.length} passages indexed</span>
      </div>

      <div class="log" data-log>
        <div class="turn bot">
          <p class="cb">Ask me about Amartya. I answer from an index of this site and link every
            source I use. If it is not in there, I will say so.</p>
        </div>
      </div>

      <div class="suggest" data-openers>
        {OPENERS.map((c, i) => <button type="button" class:list={['chip', { hard: i === OPENERS.length - 1 }]}>{c}</button>)}
      </div>

      <form class="bar" data-form>
        <label class="sr" for="ask-q">Ask a question about Amartya</label>
        <input id="ask-q" type="text" autocomplete="off" maxlength="400" placeholder="Ask something" data-q />
        <button type="button" class="reset" data-reset hidden>Clear</button>
        <button type="submit" class="go" data-go aria-label="Send">
          <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h13M12.5 6l6 6-6 6" />
          </svg>
        </button>
      </form>
    </div>

    <p class="foot-line rv">Answers name the passages they rest on, and declining is one of the five
      tools it has. That is what the last suggestion is for.</p>
  </div>

  <script type="application/json" data-index set:html={JSON.stringify(INDEX)}></script>
  <script type="application/json" data-plots set:html={JSON.stringify(PLOTS)}></script>
</section>

<script>
  const root = document.querySelector('[data-ask]');
  if (root) {
    const sec = root.closest('section');
    const INDEX = JSON.parse(sec.querySelector('[data-index]').textContent);
    const PLOTS = JSON.parse(sec.querySelector('[data-plots]').textContent);
    const log = root.querySelector('[data-log]');
    const form = root.querySelector('[data-form]');
    const input = root.querySelector('[data-q]');
    const go = root.querySelector('[data-go]');
    const reset = root.querySelector('[data-reset]');
    const openers = root.querySelector('[data-openers]');
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    const STOP = new Set(('a an the and or of to in on at is are was were be been being do does did done he his him she her ' +
      'they them their it its i you your my me we us what which who whom whose how why when where can could would should ' +
      'will has have had with for from about any some all more most much many that this these those tell show give know ' +
      'as by not no yes than then there here also into out up down over under if but so too very just really actually ' +
      'ever anything something things thing stuff please thanks hi hello hey ok okay').split(' '));

    // A dotted token is indexed whole and in parts, so "hunr" finds "hunr.ai".
    const tok = (s) => {
      const out = [];
      const keep = (w) => {
        if (w.length < 2 || STOP.has(w)) return;
        out.push(w.length > 3 && w.endsWith('s') && !w.endsWith('ss') ? w.slice(0, -1) : w);
      };
      for (const raw of String(s).toLowerCase().match(/[a-z0-9+#][a-z0-9+#.]*/g) || []) {
        const w = raw.replace(/\.+$/, '');
        keep(w);
        if (w.includes('.')) w.split('.').forEach(keep);
      }
      return out;
    };

    const N = INDEX.length;
    const df = Object.create(null);
    let totalLen = 0;
    INDEX.forEach((d) => {
      d._t = tok([d.t, d.t, d.t, d.q || '', d.k || '', d.a].join(' '));
      d._f = Object.create(null);
      d._t.forEach((w) => (d._f[w] = (d._f[w] || 0) + 1));
      totalLen += d._t.length;
      Object.keys(d._f).forEach((w) => (df[w] = (df[w] || 0) + 1));
    });
    const avgLen = totalLen / N;
    const byId = new Map(INDEX.map((d) => [d.id, d]));

    function search(q) {
      const qt = [...new Set(tok(q))].filter((w) => df[w]);
      if (!qt.length) return [];
      const k1 = 1.4, b = 0.7;
      return INDEX.map((d) => {
        let s = 0;
        for (const w of qt) {
          const f = d._f[w] || 0;
          if (!f) continue;
          s += Math.log(1 + (N - df[w] + 0.5) / (df[w] + 0.5)) *
            ((f * (k1 + 1)) / (f + k1 * (1 - b + (b * d._t.length) / avgLen)));
        }
        return { d, s };
      }).filter((x) => x.s > 0).sort((a, c) => c.s - a.s).slice(0, 6);
    }

    const valueBars = (rows, accent, unit) => {
      const max = Math.max(...rows.map((r) => r.v)) || 1;
      return '<div class="plot">' + rows.map((r) =>
        `<div class="prow"><span class="pn mono">${esc(r.n)}</span>` +
        `<span class="pt"><i style="--w:${(r.v / max) * 100}%;--c:${accent}"></i></span>` +
        `<span class="pv mono">${esc(r.v.toLocaleString('en-US'))}${unit ? ' ' + esc(unit) : ''}</span></div>`
      ).join('') + '</div>';
    };

    const timelineBars = (roles) => {
      const A = 2020, B = 2027;
      return '<div class="plot tl">' + roles.map((r) => {
        const s = ((r.from - A) / (B - A)) * 100, e = ((r.to - A) / (B - A)) * 100;
        return `<div class="prow"><span class="pn mono">${esc(r.n)}</span>` +
          `<span class="pt"><i class="${r.side ? 'side' : ''}${r.now ? ' now' : ''}" style="--s:${s}%;--w:${e - s}%"></i></span>` +
          `<span class="pv mono">${esc(r.r)}</span></div>`;
      }).join('') + '<p class="pax mono"><span>2020</span><span>2027</span></p></div>';
    };

    const chartHTML = (b) => {
      let plot;
      if (b.kind === 'roles_timeline') plot = timelineBars(b.data);
      else if (b.kind === 'composed') plot = valueBars(b.data.map((p) => ({ n: p.n, v: p.v })), 'var(--pass-lit)', b.unit);
      else plot = valueBars(b.data, b.kind === 'projects_by_status' ? 'var(--pass-lit)' : 'var(--bone)', '');
      const drop = b.dropped
        ? `<p class="mono dropped">${b.dropped} point${b.dropped === 1 ? '' : 's'} dropped for naming a passage it had not opened</p>`
        : '';
      return `<figure class="fig"><figcaption class="mono figc">${esc(b.title || '')}</figcaption>${plot}${drop}</figure>`;
    };

    const citeHTML = (sources) =>
      '<div class="cites"><span class="mono clab">Sources</span>' +
      sources.map((s) => {
        const ext = /^https?:/.test(s.u);
        return `<a class="mono cite" href="${esc(s.u)}"${ext ? ' rel="noopener"' : ''}>` +
          `${esc(s.t)}<span aria-hidden="true">${ext ? ' ↗' : ' →'}</span></a>`;
      }).join('') + '</div>';

    const followHTML = (qs) =>
      qs.length
        ? '<div class="follows">' + qs.map((q) => `<button type="button" class="chip">${esc(q)}</button>`).join('') + '</div>'
        : '';

    const el = (cls, html) => {
      const d = document.createElement('div');
      if (cls) d.className = cls;
      if (html != null) d.innerHTML = html;
      return d;
    };
    const nearBottom = () => log.scrollHeight - log.scrollTop - log.clientHeight < 90;
    const toBottom = (force) => { if (force || nearBottom()) log.scrollTop = log.scrollHeight; };
    const dots = (label) => esc(label) + '<span class="dots"><i>.</i><i>.</i><i>.</i></span>';

    let turns = [];
    let busy = false;
    let endpoint = true;

    function setBusy(v) {
      busy = v;
      go.disabled = v;
      input.disabled = v;
      root.classList.toggle('busy', v);
    }

    async function ask(q) {
      q = q.trim();
      if (!q || busy) return;
      setBusy(true);
      log.querySelectorAll('.follows').forEach((f) => (f.hidden = true));
      openers.hidden = true;
      log.appendChild(el('turn you', `<p>${esc(q)}</p>`));
      toBottom(true);
      turns.push({ role: 'user', content: q });
      reset.hidden = false;

      const bot = el('turn bot');
      const trace = el('trace');
      const status = el('status mono', dots('Scoring the index'));
      bot.append(trace, status);
      log.appendChild(bot);
      toBottom(true);

      const hits = search(q);
      const seed = hits.map((h) => h.d.id);
      trace.appendChild(el('', seed.length
        ? `<p class="mono step">Opened ${seed.length} passage${seed.length === 1 ? '' : 's'}</p>`
        : '<p class="mono step">Nothing scored above the floor</p>'));

      let answered = false;
      let streamed = null;
      let said = '';
      const dropStream = () => { if (streamed) { streamed.remove(); streamed = null; said = ''; } };

      if (endpoint) {
        status.innerHTML = dots('Thinking');
        try {
          const res = await fetch('/api/ask', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              turns,
              seed,
              plots: PLOTS,
              index: INDEX.map((d) => ({ id: d.id, t: d.t, a: d.a, u: d.u, k: d.k }))
            })
          });

          if (!res.ok || !res.body) {
            endpoint = false;
          } else {
            const reader = res.body.getReader();
            const dec = new TextDecoder();
            let tail = '';

            for (;;) {
              const { value, done } = await reader.read();
              if (done) break;
              tail += dec.decode(value, { stream: true });
              const lines = tail.split('\n');
              tail = lines.pop();

              for (const line of lines) {
                if (!line.trim()) continue;
                let ev;
                try { ev = JSON.parse(line); } catch { continue; }

                if (ev.e === 'status') {
                  status.innerHTML = dots(ev.t[0].toUpperCase() + ev.t.slice(1));
                } else if (ev.e === 'tool') {
                  status.innerHTML = dots({
                    answer: 'Writing the answer',
                    fetch_passages: 'Opening more of the index',
                    chart_preset: 'Drawing a series the page counts',
                    chart: 'Composing a chart',
                    decline: 'Deciding it does not know'
                  }[ev.name] || ev.name);
                } else if (ev.e === 'opened') {
                  trace.appendChild(el('', `<p class="mono step">Opened ${ev.ids.length} more` +
                    (ev.why ? ', ' + esc(ev.why) : '') + '</p>'));
                  toBottom();
                } else if (ev.e === 'reject') {
                  trace.appendChild(el('', `<p class="mono step bad">Rejected, ${esc(ev.why)}. Asked again.</p>`));
                  dropStream();
                  toBottom();
                } else if (ev.e === 'delta') {
                  if (!streamed) { streamed = el('cb stream'); status.before(streamed); }
                  said += ev.t;
                  streamed.textContent = said;
                  toBottom();
                } else if (ev.e === 'block') {
                  const b = ev.block;
                  if (b.type === 'text') {
                    dropStream();
                    status.before(el('said', `<p class="cb">${esc(b.text)}</p>${citeHTML(b.sources)}`));
                    turns.push({ role: 'assistant', content: b.text });
                    answered = true;
                    if (b.follow_up && b.follow_up.length) status.before(el('', followHTML(b.follow_up)));
                  } else if (b.type === 'decline') {
                    dropStream();
                    status.before(el('said no', `<p class="mono verdict no">It declined</p><p class="cb">${esc(b.reason)}</p>` +
                      '<a class="mono cite solo" href="mailto:amartya@hunr.ai">ask him instead<span aria-hidden="true"> →</span></a>'));
                    turns.push({ role: 'assistant', content: b.reason });
                    answered = true;
                    if (b.follow_up && b.follow_up.length) status.before(el('', followHTML(b.follow_up)));
                  } else if (b.type === 'chart') {
                    status.before(el('', chartHTML(b)));
                  }
                  toBottom();
                } else if (ev.e === 'error') {
                  dropStream();
                  status.before(el('said no', `<p class="mono verdict no">${esc(ev.t)}</p>`));
                  answered = true;
                }
              }
            }
          }
        } catch {
          endpoint = false;
        }
      }

      dropStream();

      // No model on this deployment. Answer from the index and be honest about it.
      if (!answered) {
        turns.pop();
        const fig = localPlot(q);
        if (fig) status.before(el('', chartHTML(fig)));
        if (!fig && (!hits.length || hits[0].s < 3.4)) {
          status.before(el('said no',
            '<p class="mono verdict no">Not in the index</p>' +
            `<p class="cb">Everything this box holds is on this page: ${PLOTS.projects} projects, five roles, ` +
            `${PLOTS.posts} posts, and a page about the guitar. Nothing in there matches that.</p>` +
            '<a class="mono cite solo" href="mailto:amartya@hunr.ai">ask him instead<span aria-hidden="true"> →</span></a>'));
        } else {
          const top = hits.slice(0, 3).map((h) => h.d);
          status.before(el('said',
            '<p class="mono verdict">Answering from the index directly</p>' +
            '<p class="cb">No model is configured on this deployment, so this is the retrieval on its own. ' +
            'These are the passages it would have been handed.</p>' +
            top.map((d) => `<p class="cb quoted">${esc(d.a)}</p>`).join('') +
            (top.length ? citeHTML(top.map((d) => ({ t: d.t, u: d.u }))) : '')));
        }
      }

      status.remove();
      setBusy(false);
      toBottom();
      if (!matchMedia('(max-width: 760px)').matches) input.focus();
    }

    // Only reached when there is no model to choose a chart for itself.
    const LOCAL_PLOT = [
      { re: /\b(timeline|career|history|chronolog|track record|how long|when did|what year|since when|overlap|experience|been doing)\b/i,
        kind: 'roles_timeline', title: 'Five spans, four of them overlapping', key: 'roles' },
      { re: /\b(shipped|production|proven|unproven|research|prototype|proof|actually built|actually done|private)\b/i,
        kind: 'projects_by_status', title: 'What the projects actually are', key: 'status' },
      { re: /\b(breakdown|how many|how much|split|spread|distribut|what kind|what sort|areas|categor|overview|summar|balance|focus|everything)\b/i,
        kind: 'projects_by_area', title: 'The projects by area', key: 'group' }
    ];
    const localPlot = (q) => {
      const m = LOCAL_PLOT.find((p) => p.re.test(q));
      return m ? { type: 'chart', kind: m.kind, title: m.title, data: PLOTS[m.key] } : null;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = input.value;
      input.value = '';
      ask(v);
    });
    root.addEventListener('click', (e) => {
      const c = e.target.closest('.chip');
      if (c && !busy) ask(c.textContent);
    });
    reset.addEventListener('click', () => {
      if (busy) return;
      turns = [];
      [...log.children].slice(1).forEach((t) => t.remove());
      openers.hidden = false;
      reset.hidden = true;
      log.scrollTop = 0;
      input.focus();
    });
  }
</script>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .box {
    margin-top: clamp(30px, 3.5vw, 44px); border: 1px solid var(--rule-dark-2); background: var(--void-2); border-radius: var(--r);
    display: grid; grid-template-rows: auto minmax(0, 1fr) auto auto;
  }

  /* A strip that tells you what you are talking to, the way any chat window does. */
  .head {
    display: flex; align-items: center; gap: 10px; padding: 13px 20px;
    border-bottom: 1px solid var(--rule-dark); background: var(--void-2);
    font-family: var(--mono); font-size: .72rem; letter-spacing: .02em;
  }
  .live { width: 7px; height: 7px; border-radius: 50%; background: var(--pass-lit); flex: none; }
  .who { color: var(--bone); }
  .idx { margin-left: auto; color: var(--bone-dim); }

  .suggest { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 20px 16px; }
  .suggest[hidden] { display: none; }

  .log { padding: 26px 24px; display: grid; align-content: start; gap: 26px; max-height: 620px; overflow-y: auto; scrollbar-width: thin; }
  /* Rows stretch so a chart gets the full width; the two things that must hug
     their content say so themselves. */
  .log :global(.turn) { display: grid; gap: 13px; }
  .log :global(.turn.you) {
    justify-self: end; max-width: 46ch; background: var(--void-3); color: var(--bone);
    border: 1px solid var(--rule-dark-2); border-radius: var(--r); border-bottom-right-radius: var(--r-sm);
    padding: 12px 17px; font-family: var(--mono); font-size: .76rem; letter-spacing: .02em; line-height: 1.5;
  }
  .log :global(.turn.you p) { margin: 0; }

  .log :global(.cb) { color: var(--bone-2); font-size: 1.04rem; line-height: 1.62; max-width: 70ch; margin: 0; }
  .log :global(.quoted) { color: var(--bone-dim); font-size: .94rem; border-left: 1px solid var(--rule-dark); padding-left: 15px; }
  .log :global(.stream::after) {
    content: ''; display: inline-block; width: .5em; height: 1.05em; margin-left: 3px; vertical-align: -.16em;
    background: var(--pass-lit); animation: askcaret 1s steps(1) infinite;
  }
  @keyframes askcaret { 50% { opacity: 0; } }

  .log :global(.trace) { display: grid; gap: 5px; }
  .log :global(.step) { color: var(--bone-dim); font-size: .72rem; letter-spacing: .01em; text-transform: none; line-height: 1.6; margin: 0; }
  .log :global(.step)::before { content: '\00B7\00A0'; }
  .log :global(.step.bad) { color: var(--fail-lit); }
  .log :global(.status) { color: var(--pass-lit); font-size: var(--t-micro); letter-spacing: .12em; }
  .log :global(.dots i) { animation: askblink 1.1s infinite; opacity: .25; font-style: normal; }
  .log :global(.dots i:nth-child(2)) { animation-delay: .18s; }
  .log :global(.dots i:nth-child(3)) { animation-delay: .36s; }
  @keyframes askblink { 40% { opacity: 1; } }

  .log :global(.said) { display: grid; gap: 13px; justify-items: start; }
  .log :global(.said) :global(.cb) { justify-self: stretch; }
  .log :global(.said.no) { border-left: 2px solid var(--fail-lit); padding-left: 16px; }
  .log :global(.verdict) { color: var(--pass-lit); text-transform: none; letter-spacing: .05em; font-size: .72rem; }
  .log :global(.verdict.no) { color: var(--fail-lit); }

  .log :global(.cites) { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .log :global(.clab) { color: var(--bone-dim); font-size: var(--t-micro); letter-spacing: .16em; margin-right: 4px; }
  .log :global(.cite) {
    font-family: var(--mono); font-size: 0.69rem; letter-spacing: .04em; text-transform: none;
    color: var(--bone-2); text-decoration: none; border: 1px solid var(--rule-dark-2); padding: 6px 11px;
    transition: color .16s ease, border-color .16s ease;
  }
  .log :global(.cite:hover) { color: var(--pass-lit); border-color: var(--pass-lit); }
  .log :global(.cite.solo) { border-color: color-mix(in oklab, var(--fail-lit) 24%, var(--void-2)); color: color-mix(in oklab, var(--fail-lit) 60%, var(--bone)); }
  .log :global(.cite.solo:hover) { color: var(--fail-lit); border-color: var(--fail-lit); }

  .log :global(.follows) { display: flex; flex-wrap: wrap; gap: 8px; }
  .log :global(.follows[hidden]) { display: none; }
  .suggest :global(.chip), .log :global(.chip) {
    font: inherit; font-family: var(--mono); font-size: 0.69rem; letter-spacing: .04em; cursor: pointer;
    background: none; border: 1px solid var(--rule-dark-2); border-radius: 999px;
    color: var(--bone-dim); padding: 8px 14px; text-align: left;
    transition: border-color .18s ease, color .18s ease, background-color .18s ease;
  }
  .suggest :global(.chip:hover), .log :global(.chip:hover) {
    border-color: color-mix(in oklab, var(--pass-lit) 45%, var(--rule-dark-2));
    color: var(--bone); background: var(--void-3);
  }
  .log :global(.chip.hard) { border-color: color-mix(in oklab, var(--fail-lit) 28%, var(--void-2)); color: color-mix(in oklab, var(--fail-lit) 60%, var(--bone)); }
  .log :global(.chip.hard:hover) { border-color: var(--fail-lit); color: var(--fail-lit); }

  .log :global(.fig) { margin: 0; display: grid; gap: 14px; padding: 16px 18px; width: 100%; background: var(--void-3); border: 1px solid var(--rule-dark-2); border-radius: var(--r-sm); }
  .log :global(.figc) { color: var(--bone); font-family: var(--body); font-size: .98rem; letter-spacing: 0; text-transform: none; }
  .log :global(.plot) { display: grid; gap: 8px; }
  .log :global(.prow) { display: grid; grid-template-columns: 152px minmax(0, 1fr) 200px; gap: 16px; align-items: center; }
  .log :global(.pn) { color: var(--bone); font-size: .73rem; letter-spacing: .02em; text-transform: none; }
  .log :global(.pt) { height: 12px; background: var(--void-3); display: block; position: relative; }
  .log :global(.pt i) { display: block; height: 100%; width: var(--w); background: var(--c, var(--bone)); animation: askgrow .6s cubic-bezier(.2,.8,.2,1); transform-origin: left; }
  .log :global(.pv) { color: var(--bone-dim); font-size: .72rem; letter-spacing: .02em; text-transform: none; }
  .log :global(.tl .pt i) { position: absolute; left: var(--s); width: var(--w); min-width: 7px; background: var(--bone); animation: none; }
  .log :global(.tl .pt i.side) { background: none; border: 1px solid var(--bone-3); }
  .log :global(.tl .pt i.now) { background: var(--pass-lit); border: 0; }
  .log :global(.pax) { display: flex; justify-content: space-between; color: var(--bone-dim); font-size: .69rem; letter-spacing: .04em; text-transform: none; margin: 2px 0 0; padding: 0 200px 0 168px; }
