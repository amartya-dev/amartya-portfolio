---
// The snapshot line, under the claim on the title page.
//
// There was a row of plain text links here once and it was cut, because every
// item in it — the index, ask, writing — already sat in the running head two
// centimetres above. This row is the opposite case: not one of these five is in
// the nav, because the nav is for parts of this document and these are the ways
// out of it. Somebody who has read one sentence and wants to check whether the
// person behind it is real goes to GitHub, and they should not have to scroll
// the length of the page to find the link.
//
// Marks rather than words alone, because five words set in a line read as a
// footnote and five marks read as somewhere to go.
const LINKS = [
  { k: 'github', l: 'GitHub', h: 'https://github.com/amartya-dev', rel: 'me noopener' },
  { k: 'linkedin', l: 'LinkedIn', h: 'https://linkedin.com/in/amartya-gaur', rel: 'me noopener' },
  { k: 'dev', l: 'DEV', h: 'https://dev.to/amartyadev', rel: 'me noopener' },
  { k: 'mail', l: 'Email', h: 'mailto:amartya@hunr.ai' },
  { k: 'cal', l: 'Book a call', h: 'https://cal.com/amartyagaur/intro', rel: 'noopener' }
];
---
<ul class="social">
  {LINKS.map((s) => (
    <li>
      <a href={s.h} rel={s.rel}>
        <span class="ic" aria-hidden="true">
          {s.k === 'github' && (
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
          )}
          {s.k === 'linkedin' && (
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
            </svg>
          )}
          {s.k === 'dev' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round">
              <rect x="1.6" y="4.4" width="20.8" height="15.2" rx="3" />
              <path d="M6 9.4v5.2h1.1a1.7 1.7 0 0 0 1.7-1.7v-1.8A1.7 1.7 0 0 0 7.1 9.4z" />
              <path d="M14 9.4h-2.4v5.2H14M11.6 12h1.9" />
              <path d="M16.4 9.4l1.5 5.2 1.5-5.2" />
            </svg>
          )}
          {s.k === 'mail' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" stroke-linejoin="round">
              <rect x="2.2" y="4.8" width="19.6" height="14.4" rx="2.4" />
              <path d="M3.2 7l8.8 6 8.8-6" />
            </svg>
          )}
          {s.k === 'cal' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="16" rx="2.4" />
              <path d="M3 9.6h18M8 3v4M16 3v4" />
              <circle cx="12" cy="15" r="1.5" fill="currentColor" stroke="none" />
            </svg>
          )}
        </span>
        <span class="lb">{s.l}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .social {
    display: flex; flex-wrap: wrap; gap: 12px 26px;
    margin-top: clamp(32px, 4vw, 46px);
    padding-top: var(--s-3); border-top: 1px solid var(--rule-dark);
  }
  .social a {
    display: inline-flex; align-items: center; gap: 9px;
    color: var(--bone-2); text-decoration: none;
    font-size: var(--t-small); font-weight: 500; letter-spacing: -.004em;
  }
  .ic { display: block; width: 18px; height: 18px; color: var(--bone-dim); transition: color .16s ease; }
  .ic svg { width: 100%; height: 100%; display: block; }
  .lb { border-bottom: 1px solid transparent; padding-bottom: 2px; transition: border-color .16s ease; }

  .social a:hover { color: var(--bone); }
  .social a:hover .ic { color: var(--fail-lit); }
  .social a:hover .lb { border-bottom-color: var(--rule-dark-2); }

  /* Under about 520px five icon-and-word pairs will not hold a single line, and
     wrapping them into two ragged rows looks like an accident. The words go and
     the marks stay, which is the half that still works at that size. */
  @media (max-width: 520px) {
    .social { gap: 22px; }
    .lb { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .ic { width: 21px; height: 21px; }
  }
</style>
